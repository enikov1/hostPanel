  stPhpChanged, siteSave, toggleMaintenance, openSite, nodeAct, nodeLogsDlg,
  defaultSiteDlg, defaultSiteSave, siteAuditDlg, sslIssue, sslDel, loadSiteStats,
  loadSiteLoad, loadSiteHealth, loadSiteConf, saveSiteConf, loadSiteSecurity,
  secAddCountry, secRemoveCountry, secAddIp, secRemoveIp, secSave, secGeoInstall, siteLog,
  siteLogRefresh, applyLogFilters, openSiteFiles, logsClear, stFpmReco,
  siteDnsFullDlg, importArchiveDlg, importArchiveGo };
