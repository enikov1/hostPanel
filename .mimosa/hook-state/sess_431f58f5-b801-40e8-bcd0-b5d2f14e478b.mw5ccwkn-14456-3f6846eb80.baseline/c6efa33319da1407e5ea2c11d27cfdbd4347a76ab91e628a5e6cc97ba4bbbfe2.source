'use strict';
/* ============ Страницы: Сайты, Базы данных ============ */
const WEBSERVERS = [
  ['nginx', 'nginx + PHP-FPM (рекомендуется)'],
  ['nginx+apache', 'nginx + Apache (mod_php-совместимость)'],
  ['apache', 'Apache (напрямую)'],
  ['nginx+node', 'nginx + Node.js (прокси)'],
  ['static', 'Статика без PHP'],
];

async function pgSites(c){
  c.innerHTML = '<div class="empty">Загрузка…</div>';
  let d, apps;
  try {
    const res = await Promise.all([
      api('/api/sites'),
      api('/api/apps').then(x => x.apps || []).catch(() => [])]);
    d = res[0]; apps = res[1];
  } catch(e){ c.innerHTML=''; toastErr(e); return; }
  window._pmaByDomain = {};
  apps.forEach(a => { if (a.installed) window._pmaByDomain[a.domain] = a; });
  const roots = d.sites.filter(s => !s.parent);
  const subs = d.sites.filter(s => s.parent);
  if (!d.sites.length) {
    c.innerHTML =
      '<div class="card" style="text-align:center;padding:54px 20px">' +
      '<div style="max-width:520px;margin:0 auto">' +
      '<div class="empty" style="padding:0 0 8px">Здесь появятся ваши сайты.</div>' +
      '<div class="muted" style="font-size:13.5px;line-height:1.6;margin-bottom:18px">' +
      'Сайт — это ваш адрес в интернете, например <b>mysite.ru</b>. Создайте его здесь, ' +
      'затем загрузите файлы и привяжите домен. Если PHP ещё не установлен, мастер подскажет.</div>' +
      '<button class="btn primary" onclick="wizardSite()">' + icon('plus',15) + ' Создать первый сайт</button>' +
      '</div></div>';
    return;
  }
  c.innerHTML =
    '<div class="toolbar"><button class="btn primary" onclick="wizardSite()">' + icon('plus',15) +
    'Создать сайт</button>' +
    '<button class="btn" title="Страница, которая открывается по IP-адресу сервера (404, закрыта от индексации)" ' +
    'onclick="defaultSiteDlg()">' + icon('file',15) + ' Заглушка для IP</button><span class="spacer"></span>' +
    '<span class="muted" style="font-size:13px">Сайтов: ' + d.sites.length +
    ' · поддоменов: ' + subs.length + '</span></div>' +
    diskCard(d.sites) +
    '<div class="card" style="padding:6px 10px"><div class="twrap"><table>' +
    '<thead><tr><th>Домен</th><th>Веб-сервер</th><th>PHP / Node</th><th>SSL</th><th>Фильтры</th><th>Место</th><th>Статус</th><th></th></tr></thead><tbody>' +
    roots.map(s => siteRow(s, subs.filter(x => x.parent === s.id))).join('') +
    '</tbody></table></div></div>' +
    '<div class="faint" style="font-size:12px;margin-top:10px">SSL — это защита соединения: сайт открывается ' +
    'по https:// и браузер показывает замочек. «Настройки» — версия PHP, SSL, безопасность и файлы сайта.</div>' +
    (ME.demo ? '<div class="notice info">Демо-режим: конфиги веб-сервера не изменяются, все данные фиктивные.</div>' : '');
  drawDiskChart(d.sites);
  dnsPills(d.sites.filter(s => !s.parent));
}

/* плашки DNS у сайтов без SSL: домен уже указывает на сервер?
   Проверяются последовательно, чтобы не создавать очереди процессов. */
async function dnsPills(sites){
  for (const s of sites) {
    const el = document.getElementById('dns-pill-' + s.id);
    if (!el) continue;
    let r = null;
    try { r = await api('/api/site/' + s.id + '/dns_check'); }
    catch(e) { el.remove(); continue; }
    if (!el.isConnected) continue;
    const ips = (r.server_ips || []).join(', ');
    if (r.dns_ok) {
      el.className = 'pill ok';
      el.textContent = 'DNS ок';
      el.title = 'Домен указывает на этот сервер — можно выпускать Let\'s Encrypt';
    } else {
      el.className = 'pill warn';
      el.textContent = 'DNS не настроен';
      el.title = 'Домен ' + s.domain + ' пока НЕ указывает на этот сервер. ' +
        'Добавьте у регистратора A-запись: ' + s.domain + ' → ' +
        (ips || 'IP сервера (см. «Обзор»)') + '. Изменения DNS применяются до нескольких часов.';
    }
  }
}

/* карточка «Место по сайтам»: бары текущего размера + график роста */
function diskCard(sites){
  const rows = sites.filter(s => !s.parent)
    .map(s => ({domain: s.domain, disk: s.disk || 0, hist: s.disk_hist || []}))
    .sort((a, b) => b.disk - a.disk).slice(0, 8);
  if (!rows.length) return '';
  const total = rows.reduce((a, x) => a + x.disk, 0);
  const max = Math.max(...rows.map(x => x.disk), 1);
  const bars = rows.map(x => {
    const pct = Math.max(2, Math.round(x.disk / max * 100));
    const grow = x.hist.length >= 2
      ? (x.disk - x.hist[0].mb * 1024 * 1024) : 0;
    const growTxt = grow > 1024 * 1024
      ? ' <span class="pill warn" style="font-size:11px">+' + fmtSize(grow) + '</span>'
      : (grow < -1024 * 1024
        ? ' <span class="pill ok" style="font-size:11px">' + fmtSize(grow) + '</span>' : '');
    return '<div class="row" style="align-items:center;gap:10px;padding:3px 0">' +
      '<span style="width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap" title="' + esc(x.domain) + '">' + esc(x.domain) + '</span>' +
      '<div style="flex:1;height:14px;border-radius:7px;background:var(--border);overflow:hidden">' +
      '<div style="width:' + pct + '%;height:100%;border-radius:7px;background:var(--primary)"></div></div>' +
      '<b style="width:70px;text-align:right">' + fmtSize(x.disk) + '</b>' + growTxt + '</div>';
  }).join('');
  return '<div class="card" style="margin-bottom:12px"><div class="card-h">' +
    '<span class="card-t">Место по сайтам</span><span class="card-spacer"></span>' +
    '<span class="pill gray">всего ' + fmtSize(total) + '</span></div>' +
    '<div style="padding:6px 8px 2px">' + bars + '</div>' +
    '<canvas id="sites-disk-chart" class="chart" style="height:120px;margin-top:6px"></canvas>' +
    '<div class="faint" style="font-size:11.5px;padding:0 8px 8px">Полоски — текущий размер папки каждого сайта, ' +
    'график — суммарный рост места (точка раз в 6 часов). Жёлтый значок — прирост с первой точки истории.</div></div>';
}
function drawDiskChart(sites){
  const cv = document.getElementById('sites-disk-chart');
  if (!cv) return;
  const byDate = {};
  sites.filter(s => !s.parent).forEach(s =>
    (s.disk_hist || []).forEach(p => {
      const day = (p.t || '').slice(0, 10);
      // точка раз в 6 часов — берём ПОСЛЕДНЮЮ точку дня, а не сумму
      // (суммирование завышало размер сайта в ~4 раза)
      if (day) byDate[day] = (p.mb || 0);
    }));
  const days = Object.keys(byDate).sort();
  if (days.length < 2) {
    cv.style.display = 'none';
    return;
  }
  const data = days.map(d => byDate[d]);
  drawLine(cv, [{data, color: cssVar('--primary'), fill: true}],
    {labels: [days[0], days[days.length - 1]],
     max: Math.max(...data, 1) * 1.2});
}

/* кнопка phpMyAdmin в строке сайта: открыть (если стоит) или установить */
function pmaSiteBtn(domain, hasPhp){
  if (!hasPhp) return '';
  const a = (window._pmaByDomain || {})[domain];
  return '<button class="btn sm" title="' + (a ?
    'phpMyAdmin установлен — открыть в новом окне' :
    'Установить phpMyAdmin в папку /pma этого сайта') +
    '" onclick="pmaSiteDlg(\'' + esc(domain) + '\')">' +
    icon(a ? 'ext' : 'down', 14) + ' phpMyAdmin</button>';
}

function pmaSiteDlg(domain){
  const a = (window._pmaByDomain || {})[domain];
  if (a) {
    modal('phpMyAdmin — ' + esc(domain),
      '<div class="kv"><b>Адрес</b><span class="mono">' + esc(a.url) + '</span></div>' +
      (a.protected
        ? '<div class="field" style="margin-top:8px"><label>Вход в папку (basic auth)</label>' +
          credRow('логин', a.user) + credRow('пароль', a.password, 'pma-site-pass') +
          '<div class="faint" style="font-size:12px">Затем внутри phpMyAdmin — пользователь и пароль MySQL.</div></div>'
        : '<div class="notice warn" style="margin-top:8px">Папка не закрыта паролем — входите сразу пользователем MySQL.</div>') +
      '<div class="row" style="margin-top:14px">' +
      '<button class="btn primary" onclick="pmaSiteOpen(\'' + esc(domain) + '\')">' + icon('ext',15) + ' Открыть в новом окне</button>' +
      '<button class="btn" onclick="swsetGo(\'pma\')">Настройки</button>' +
      '<button class="btn danger" onclick="pmaRemoveDlg(\'' + esc(domain) + '\')">Удалить</button></div>',
      '<button class="btn" onclick="closeModal(); go(\'sites\')">Закрыть</button>', true);
    return;
  }
  modal('Установить phpMyAdmin — ' + esc(domain),
    '<div class="notice info">phpMyAdmin — веб-интерфейс для работы с базами данных. ' +
    'Скачивается с официального сайта и ставится в папку <b>/pma</b> этого сайта.</div>' +
    '<label class="check" style="margin:6px 0 4px"><input type="checkbox" ' +
    'id="ps-protect" checked onchange="pmaProtToggle()"> ' +
    'Закрыть папку паролем (рекомендуется)</label>' +
    '<div class="field" id="pma-pass-row">' +
    pwField('pma-pass', {label:'Пароль папки /pma',
      hint:'Понадобится при входе в phpMyAdmin. Сохраните его.'}) + '</div>' +
    '<div class="notice info">Внутри phpMyAdmin входите пользователем базы — ' +
    'реквизиты есть в разделе «Базы данных».</div>',
    '<button class="btn primary" onclick="pmaSiteInstall(\'' + esc(domain) + '\')">' +
    icon('down',15) + ' Установить</button>' +
    '<button class="btn" onclick="closeModal()">Отмена</button>', true);
  setTimeout(() => { pwGenerate('pma-pass'); pwBindStrength('pma-pass'); }, 250);
}
function pmaSiteOpen(domain){
  const a = (window._pmaByDomain || {})[domain];
  if (a) window.open(a.url, '_blank');
  else toast('phpMyAdmin ещё не установлен', 'warn');
}
async function pmaSiteInstall(domain){
  const el = document.getElementById('ps-protect');
  const protect = el ? el.checked : true;
  const passEl = document.getElementById('pma-pass');
  try {
    const r = await api('/api/apps/install', {method:'POST',
      body:{app:'pma', site: domain, protect,
        password: passEl ? passEl.value : ''}});
    closeModal();
    toast(esc(r.message));
    pmaSiteWait();
  } catch(e){ toastErr(e); }
}
async function pmaSiteWait(){
  for (let i = 0; i < 180; i++) {
    await new Promise(r => setTimeout(r, 2000));
    try { const t = await api('/api/apps'); if (!t.running) break; }
    catch(e){ return; }
  }
  toast('phpMyAdmin готов — кнопка «phpMyAdmin» у сайта покажет адрес и доступы');
  if (PAGE === 'sites') go('sites');
}

function siteRow(s, children){
  const ws = (WEBSERVERS.find(w => w[0]===s.webserver)||[,'?'])[1];
  let phpnode = s.php ? 'PHP ' + esc(s.php) : '';
  if (s.node && s.node.enabled) phpnode = (phpnode? phpnode + ' + ' : '') + 'Node ' + esc(s.node.version);
  const ssl = s.ssl && s.ssl.kind !== 'none';
  let sslPill = '<span class="pill gray">нет</span>';
  if (ssl) {
    const days = Math.round((new Date(s.ssl.expires) - new Date()) / 86400000);
    const kind = s.ssl.kind === 'letsencrypt' ? "Let's Encrypt" : 'самоподписанный';
    if (isNaN(days)) {
      sslPill = '<span class="pill warn">' + kind + '</span>';
    } else {
      const cls = days < 20 ? 'err' : days < 40 ? 'warn' : 'ok';
      sslPill = '<span class="pill ' + cls + '">' + kind + ' · ' + days + ' дн.</span>';
    }
  }
  const subRows = children.map(ch =>
    '<tr class="sub-row"><td style="padding-left:26px"><span class="faint">└</span> <b>' + esc(ch.domain) + '</b>' +
    (ch.enabled ? '' : ' <span class="pill warn">отключён</span>') +
    (ch.maintenance ? ' <span class="pill warn">обслуж.</span>' : '') + '</td>' +
    '<td class="muted">' + esc((WEBSERVERS.find(w => w[0]===ch.webserver)||[,'?'])[1]) + '</td>' +
    '<td class="muted">' + (ch.php ? 'PHP ' + esc(ch.php) : '—') + '</td>' +
    '<td>' + (ch.ssl && ch.ssl.kind !== 'none' ?
      '<span class="pill ok">SSL</span>' : '<span class="pill gray">нет</span>') + '</td>' +
    '<td class="muted" style="font-size:12px">' + esc(ch.security_status||'нет') + '</td>' +
    '<td class="muted">' + fmtSize(ch.disk) + '</td>' +
    '<td><span class="pill ' + (ch.enabled?'ok':'gray') + '">' + (ch.enabled?'работает':'отключён') + '</span></td>' +
    '<td><div class="actions-cell">' +
    '<button class="btn sm" onclick="siteDlg(' + ch.id + ')">' + icon('gear',14) + '</button>' +
    pmaSiteBtn(ch.domain, ch.php) +
    '<button class="btn sm icon danger" onclick="delSite(' + ch.id + ', \'' + esc(ch.domain) + '\')">' + icon('trash',14) + '</button>' +
    '</div></td></tr>').join('');
  return '<tr><td><b>' + esc(s.domain) + '</b>' +
    (s.enabled ? '' : ' <span class="pill warn">отключён</span>') +
    (s.maintenance ? ' <span class="pill warn">обслуживание</span>' : '') +
    (!ssl ? ' <span class="pill gray" id="dns-pill-' + s.id +
      '" title="Проверяю DNS-запись домена…">DNS…</span>' : '') +
    '</td>' +
    '<td>' + esc(ws) + '</td><td>' + (phpnode || '<span class="faint">—</span>') + '</td>' +
    '<td>' + sslPill + '</td>' +
    '<td class="muted" style="font-size:12px">' + esc(s.security_status||'нет') + '</td>' +
    '<td>' + fmtSize(s.disk) + '</td>' +
    '<td><span class="pill ' + (s.enabled?'ok':'gray') + '"><span class="dot"></span>' +
    (s.enabled?'работает':'отключён') + '</span></td>' +
    '<td><div class="actions-cell">' +
    '<button class="btn sm" onclick="siteDlg(' + s.id + ')">' + icon('gear',14) + ' Настройки</button>' +
    pmaSiteBtn(s.domain, s.php) +
    '<button class="btn sm icon" title="Вкл/выкл сайт" onclick="toggleSite(' + s.id + ')">' + icon('play',14) + '</button>' +
    '<button class="btn sm icon" title="Поддомен" onclick="wizardSubdomain(' + s.id + ', \'' + esc(s.domain) + '\')">' + icon('plus',14) + '</button>' +
    '<button class="btn sm icon danger" title="Удалить" onclick="delSite(' + s.id + ', \'' + esc(s.domain) + '\')">' + icon('trash',14) + '</button>' +
    '</div></td></tr>' + subRows;
}

async function toggleSite(id){
  try { const r = await api('/api/sites/toggle', {method:'POST', body:{id}}); toast(esc(r.message)); go(PAGE); }
  catch(e){ toastErr(e); }
}
function delSite(id, domain){
  confirmDlg('Удалить сайт', 'Сайт <b>' + esc(domain) + '</b>, его конфиги и поддомены будут удалены. Файлы в папке сайта останутся. Продолжить?',
    async () => {
      try { const r = await api('/api/sites/delete', {method:'POST', body:{id, delete_files:false}});
        toast(esc(r.message)); go(PAGE); } catch(e){ toastErr(e); }
    });
}

/* ---------- мастер создания сайта ---------- */
async function wizardSite(){
  let php, engines;
  try {
    const res = await Promise.all([
      api('/api/php').catch(() => ({versions: {}})),
      api('/api/db').then(x => x.engines || []).catch(() => [])]);
    php = res[0].versions || {}; engines = res[1];
  } catch(e){ php = {}; engines = []; }
  window._wzEngines = engines.filter(e => e.available);
  const versions = Object.keys(php).sort().reverse();
  const phpOpts = versions.map(v => '<option value="' + v + '">PHP ' + v + '</option>').join('');
  const engOpts = window._wzEngines.map(e => '<option value="' + e.id + '">' + esc(e.name) + '</option>').join('');
  modal('Новый сайт',
    '<div class="field"><label>Домен (адрес сайта)</label>' +
    '<input type="text" id="wz-domain" placeholder="например, mysite.ru" autofocus></div>' +
    '<div class="field"><label>На чём работает сайт</label><select id="wz-ws" onchange="wzUpdate()">' +
      WEBSERVERS.map(w => '<option value="'+w[0]+'">'+w[1]+'</option>').join('') + '</select>' +
      '<div class="faint" style="font-size:11.5px;margin-top:4px">Если не знаете, что выбрать — оставьте как есть.</div></div>' +
    '<div id="wz-php-block"><div class="field"><label>Версия PHP</label><select id="wz-php">' + phpOpts + '</select></div></div>' +
    '<div id="wz-node-block" class="hidden">' +
      '<div class="row"><div class="field" style="flex:1"><label>Версия Node.js</label><select id="wz-node-v"><option>20</option><option>18</option><option>22</option></select></div>' +
      '<div class="field" style="flex:1"><label>Порт приложения</label><input type="number" id="wz-node-p" value="3000"></div>' +
      '<div class="field" style="flex:1"><label>Файл запуска</label><input type="text" id="wz-node-s" value="app.js"></div></div></div>' +
    '<div class="field"><label>Защита соединения (SSL)</label><select id="wz-ssl" onchange="wzUpdate()">' +
      '<option value="none">Пока без SSL — можно включить позже</option>' +
      '<option value="letsencrypt">Бесплатный сертификат Let\'s Encrypt (нужен работающий домен)</option>' +
      '<option value="selfsigned">Самоподписанный (для тестов)</option></select></div>' +
    '<div id="wz-email-block" class="field hidden"><label>E-mail для сертификата</label><input type="email" id="wz-email" placeholder="admin@example.ru"></div>' +
    '<label class="check"><input type="checkbox" id="wz-db" checked onchange="wzUpdate()"> Создать базу данных (нужна для WordPress, магазинов и т.п.)</label>' +
    (window._wzEngines.length > 1
      ? '<div class="field" id="wz-db-eng-block"><label>Тип базы</label><select id="wz-db-eng">' + engOpts + '</select>' +
        '<div class="faint" style="font-size:11.5px;margin-top:4px">MariaDB подходит большинству сайтов (WordPress, Opencart); PostgreSQL — если приложение требует именно её.</div></div>'
      : '') +
    '<div class="notice info">Всё остальное — папка сайта, настройки веб-сервера — создастся автоматически.</div>',
    '<button class="btn primary" onclick="wizardCreate()">' + icon('check',15) + ' Создать сайт</button>' +
    '<button class="btn" onclick="closeModal()">Отмена</button>', true);
  wzUpdate();
  setTimeout(() => { const i = $('#wz-domain'); if (i) i.focus(); }, 80);
}
function wzUpdate(){
  const ws = $('#wz-ws').value;
  $('#wz-php-block').classList.toggle('hidden', !(ws==='nginx'||ws==='nginx+apache'||ws==='apache'));
  $('#wz-node-block').classList.toggle('hidden', ws!=='nginx+node');
  $('#wz-email-block').classList.toggle('hidden', $('#wz-ssl').value!=='letsencrypt');
  const engBlock = document.getElementById('wz-db-eng-block');
  if (engBlock) engBlock.classList.toggle('hidden', !$('#wz-db').checked);
}
async function wizardCreate(){
  const body = {
    domain: $('#wz-domain').value.trim(), webserver: $('#wz-ws').value,
    php: $('#wz-php') ? $('#wz-php').value : '',
    ssl_kind: $('#wz-ssl').value, email: $('#wz-email') ? $('#wz-email').value : '',
    create_db: $('#wz-db').checked,
    db_engine: $('#wz-db-eng') ? $('#wz-db-eng').value :
      ((window._wzEngines && window._wzEngines[0]) ?
        window._wzEngines[0].id : 'mysql'),
    node_version: $('#wz-node-v') ? $('#wz-node-v').value : '20',
    node_port: $('#wz-node-p') ? $('#wz-node-p').value : 3000,
    node_script: $('#wz-node-s') ? $('#wz-node-s').value : 'app.js',
  };
  let r;
  try {
    r = await api('/api/sites/create', {method:'POST', body});
  } catch(e){ toastErr(e); return; }
  closeModal();
  const dom = esc(body.domain);
  let dbHtml = '';
  if (r.db) {
    dbHtml = '<div class="notice ok">Вместе с сайтом создана база данных — сохраните реквизиты:</div>' +
      credRow('СУБД', r.db.engine === 'pg' ? 'PostgreSQL' : 'MariaDB / MySQL') +
      credRow('Название базы', r.db.name) +
      credRow('Пользователь', r.db.user) +
      credRow('Пароль', r.db.password, 'wz-db-pass') +
      '<div class="faint" style="font-size:12px;margin:4px 0 10px">Сервер (хост): <b class="mono">localhost</b></div>';
  } else {
    dbHtml = '';
  }
  modal('Сайт «' + dom + '» создан',
    '<div class="notice ok">Сайт готов и уже работает. Что можно сделать дальше:</div>' + dbHtml +
    '<div class="kv" style="margin:8px 0 4px">' +
    '<b>Файлы сайта</b><span>раздел «Файловый менеджер» — загрузите туда файлы вашего сайта</span>' +
    '<b>Защита (SSL)</b><span>в настройках сайта включите бесплатный сертификат — тогда сайт будет открываться по https://</span>' +
    '<b>Домен</b><span>настройте у регистратора A-запись домена на IP этого сервера</span>' +
    '</div>',
    '<button class="btn primary" onclick="closeModal(); openSite(\'' + body.domain + '\')">Открыть сайт</button>' +
    '<button class="btn" onclick="closeModal(); go(\'files\')">Загрузить файлы</button>' +
    '<button class="btn" onclick="closeModal(); siteDlg(' + r.site_id + ')">Настройки сайта</button>' +
    '<button class="btn" onclick="closeModal(); go(\'sites\')">Готово</button>', true);
  go('sites');
}

/* ---------- мастер поддомена ---------- */
async function wizardSubdomain(parentId, parentDomain){
  let php;
  try { php = (await api('/api/php')).versions; } catch(e){ php = {}; }
  const versions = Object.keys(php).sort().reverse();
  modal('Новый поддомен' + (parentDomain ? ' для ' + esc(parentDomain) : ''),
    '<div class="notice info">Полное имя поддомена: <b><span id="sub-preview">….' + esc(parentDomain || '') + '</span></b>. ' +
    'Папка создастся внутри сайта: subdomains/&lt;имя&gt;/public_html. SSL выпускается отдельно.</div>' +
    '<div class="field"><label>Имя поддомена (без точки)</label>' +
    '<input type="text" id="sub-name" placeholder="например, blog или shop" oninput="$(\'#sub-preview\').textContent=this.value+\'.'+esc(parentDomain||'')+'\'"></div>' +
    '<div class="field"><label>Веб-сервер</label><select id="sub-ws">' +
      WEBSERVERS.map(w => '<option value="'+w[0]+'">'+w[1]+'</option>').join('') + '</select></div>' +
    '<div class="field"><label>Версия PHP</label><select id="sub-php">' +
      versions.map(v => '<option value="' + v + '">PHP ' + v + '</option>').join('') + '</select></div>' +
    '<div class="field"><label>SSL</label><select id="sub-ssl">' +
      '<option value="none">Без SSL</option><option value="letsencrypt">Let\'s Encrypt</option>' +
      '<option value="selfsigned">Самоподписанный</option></select></div>',
    '<button class="btn primary" onclick="subCreate(' + parentId + ')">' + icon('check',15) + ' Создать поддомен</button>' +
    '<button class="btn" onclick="closeModal()">Отмена</button>');
}
async function subCreate(parentId){
  const name = $('#sub-name').value.trim();
  try {
    const d = await api('/api/sites');
    const parent = d.sites.find(s => s.id === parentId);
    const domain = name + '.' + parent.domain;
    const r = await api('/api/sites/create', {method:'POST', body:{
      domain, parent: parentId, webserver: $('#sub-ws').value,
      php: $('#sub-php').value, ssl_kind: $('#sub-ssl').value}});
    closeModal(); toast(esc(r.message)); go('sites');
  } catch(e){ toastErr(e); }
}

/* ---------- модал настроек сайта ---------- */
async function siteDlg(id){
  let d, phpData;
  try { d = (await api('/api/sites')).sites.find(s => s.id === id);
    phpData = await api('/api/php'); } catch(e){ toastErr(e); return; }
  if (!d) { toast('Сайт не найден — обновите список сайтов', 'warn'); return; }
  const s = d; window._site = s;
  const versions = Object.keys(phpData.versions).sort().reverse();
  const mods = phpData.versions[s.php] || [];
  const modNames = phpData.module_names || {};
  window._phpMods = mods;
  const tabBtn = (t, l) => '<button class="tab" data-tab="'+t+'" onclick="stTab(\''+t+'\')">'+l+'</button>';
  const perf = s.perf || {};
  const isNode = s.webserver === 'nginx+node';
  const hasSsl = s.ssl && s.ssl.kind !== 'none';
  modal('Сайт: ' + esc(s.domain),
    '<div class="tabs" id="st-tabs">' + tabBtn('main','Основное') + tabBtn('php','PHP и FPM') +
    tabBtn('node','Node.js') + tabBtn('ssl','SSL') + tabBtn('sec','Фильтры') +
    (ME.expert ? tabBtn('conf','Конфиги') : '') +
    tabBtn('stats','Статистика') + tabBtn('load','Нагрузка') +
    tabBtn('health','Живучесть') + tabBtn('logs','Логи') + '</div>' +
    '<div id="st-body"></div>',
    '<button class="btn primary" onclick="siteSave()">' + icon('check',15) + ' Сохранить</button>' +
    '<button class="btn" onclick="closeModal()">Закрыть</button>', 2);
  window._stTab = 'main';
  window._stMain = stMainHtml(s);
  window._stPhp = '<div class="field"><label>Версия PHP</label><select id="st-php" onchange="stPhpChanged()">' +
    versions.map(v => '<option value="'+v+'"'+(s.php===v?' selected':'')+'>PHP '+v+'</option>').join('') + '</select></div>' +
    '<label>Модули PHP (для версии ' + esc(s.php || '—') + ')</label>' +
    '<div id="st-mods" style="max-height:180px;overflow:auto;border:1px solid var(--border);border-radius:10px;padding:10px">' +
    mods.map(m => '<label class="check" style="margin:4px 0"><input type="checkbox" class="st-mod" value="'+esc(m)+'"'+
      ((s.php_modules||[]).includes(m)?' checked':'')+'> ' + esc(m) +
      (modNames[m] ? ' <span class="faint">— '+esc(modNames[m])+'</span>' : '') + '</label>').join('') + '</div>' +
    '<div class="row" style="margin-top:8px"><button class="btn sm" onclick="openPhpModules()">' + icon('pkg',14) + ' Установить модули (apt)</button></div>' +
    '<label style="margin-top:12px">Настройки пула PHP-FPM</label>' +
    '<div class="row"><div class="field" style="flex:1"><label>Режим</label><select id="st-fpm-pm">' +
    ['dynamic','static','ondemand'].map(m => '<option'+(s.fpm&&s.fpm.pm===m?' selected':'')+'>'+m+'</option>').join('') + '</select></div>' +
    '<div class="field" style="flex:1"><label>max_children</label><input type="number" id="st-fpm-mc" value="'+(s.fpm?s.fpm.max_children:10)+'"></div>' +
    '<div class="field" style="flex:1"><label>start_servers</label><input type="number" id="st-fpm-ss" value="'+(s.fpm?s.fpm.start_servers:3)+'"></div></div>' +
    '<div class="row" style="margin-top:8px;align-items:center"><button class="btn sm" onclick="stFpmReco()">' + icon('zap',14) + ' Подобрать под сервер</button>' +
    '<span class="faint" id="st-fpm-reco" style="font-size:11.5px"></span></div>';
  window._stNode = (s.node ? '' : '<div class="notice warn">Node.js недоступен для этого сайта</div>') ||
    '<label class="check"><input type="checkbox" id="st-node-en"'+(s.node&&s.node.enabled?' checked':'')+'> Приложение Node.js включено (systemd-юнит)</label>' +
    '<div class="row"><div class="field" style="flex:1"><label>Версия</label><select id="st-node-v">' +
    ['18','20','22'].map(v => '<option'+(s.node&&s.node.version===v?' selected':'')+'>'+v+'</option>').join('') + '</select></div>' +
    '<div class="field" style="flex:1"><label>Порт</label><input type="number" id="st-node-p" value="'+(s.node?s.node.port:3000)+'"></div>' +
    '<div class="field" style="flex:1"><label>Файл запуска</label><input type="text" id="st-node-s" value="'+(s.node?esc(s.node.script):'app.js')+'"></div></div>' +
    '<div class="row"><button class="btn" onclick="nodeAct(\'restart\')">' + icon('refresh',15) + ' Перезапустить</button>' +
    '<button class="btn" onclick="nodeAct(\'npm\')">' + icon('down',15) + ' npm install</button>' +
    '<button class="btn" onclick="nodeLogsDlg()">' + icon('file',15) + ' Журнал приложения</button></div>';
  window._stSsl = sslBlockHtml(s);
  window._stSec = null;  // загружается асинхронно
  stTab('main');
}

function sslBlockHtml(s){
  const ssl = s.ssl || {kind:'none'};
  const dnsBtn = '<div class="row" style="margin-top:12px"><button class="btn" onclick="sslDnsCheck()">' +
    icon('globe',15) + ' Проверить DNS домена</button>' +
    '<button class="btn" onclick="siteDnsFullDlg()">' + icon('search',15) + ' Полная диагностика DNS</button></div>' +
    '<div id="ssl-dns" style="margin-top:10px"></div>';
  if (ssl.kind === 'none')
    return '<div class="notice warn">SSL не настроен. Рекомендуется Let\'s Encrypt — бесплатный сертификат с автопродлением.</div>' +
      '<div class="row"><button class="btn primary" onclick="sslIssue(\'letsencrypt\')">Выпустить Let\'s Encrypt</button>' +
      '<button class="btn" onclick="sslIssue(\'selfsigned\')">Самоподписанный</button></div>' + dnsBtn;
  const days = Math.round((new Date(ssl.expires) - new Date()) / 86400000);
  const daysTxt = isNaN(days) ? '' : ' (' + days + ' дн.)';
  return '<div class="kv"><b>Тип</b><span>' + (ssl.kind==='letsencrypt'?"Let's Encrypt":'Самоподписанный') + '</span>' +
    '<b>Домены</b><span>' + esc((ssl.domains||[]).join(', ')) + '</span>' +
    '<b>Действует до</b><span>' + esc(ssl.expires) + daysTxt + '</span></div>' +
    '<div class="row" style="margin-top:14px"><button class="btn" onclick="sslIssue(\'letsencrypt\')">' + icon('refresh',15) + ' Перевыпустить</button>' +
    '<button class="btn danger" onclick="sslDel()">Удалить сертификат</button></div>' + dnsBtn;
}
async function sslDnsCheck(){
  const el = document.getElementById('ssl-dns');
  if (!el) return;
  el.innerHTML = '<div class="empty">Проверяю DNS…</div>';
  try {
    const r = await api('/api/site/' + window._site.id + '/dns_check');
    const pill = r.dns_ok ? '<span class="pill ok">указывает на этот сервер</span>'
      : '<span class="pill err">не указывает на этот сервер</span>';
    el.innerHTML =
      '<div class="kv"><b>Домен</b><span class="mono">' + esc(r.domain) + ' ' + pill + '</span>' +
      '<b>A-записи</b><span class="mono">' + esc((r.ipv4||[]).join(', ')||'—') + '</span>' +
      '<b>AAAA-записи</b><span class="mono">' + esc((r.ipv6||[]).join(', ')||'—') + '</span>' +
      '<b>IP сервера</b><span class="mono">' + esc((r.server_ips||[]).join(', ')||'—') + '</span></div>' +
      (r.dns_ok ? '' : '<div class="notice warn" style="margin-top:8px">Для Let\'s Encrypt домен должен указывать на IP этого сервера: измените A-запись в панели регистратора домена и повторите проверку.</div>');
  } catch(e) { el.innerHTML = '<div class="notice err">' + esc(e.message) + '</div>'; }
}

function stTab(t){
  window._stTab = t;
  document.querySelectorAll('#st-tabs .tab').forEach(b => b.classList.toggle('active', b.dataset.tab === t));
  const map = {main: window._stMain, php: window._stPhp, node: window._stNode,
    ssl: window._stSsl, stats: '<div class="empty">Загрузка…</div>',
    load: '<div class="empty">Загрузка…</div>', health: '<div class="empty">Загрузка…</div>',
    logs: '<div class="empty">Загрузка…</div>', conf: '<div class="empty">Загрузка…</div>',
    sec: '<div class="empty">Загрузка…</div>'};
  $('#st-body').innerHTML = map[t] || '';
  if (t === 'stats') loadSiteStats();
  if (t === 'load') loadSiteLoad();
  if (t === 'health') loadSiteHealth();
  if (t === 'conf') loadSiteConf('nginx');
  if (t === 'sec') loadSiteSecurity();
  if (t === 'logs') $('#st-body').innerHTML =
    '<div class="row" style="margin-bottom:10px">' +
    '<button class="btn sm" onclick="siteLog(\'access\')">Access-лог</button>' +
    '<button class="btn sm" onclick="siteLog(\'error\')">Error-лог</button>' +
    '<span class="spacer"></span><span class="muted" style="font-size:12.5px">последние 300 строк</span>' +
    '<button class="btn sm danger" onclick="logsClear(\'access\')">Очистить access</button>' +
    '<button class="btn sm danger" onclick="logsClear(\'error\')">Очистить error</button></div>' +
    '<div class="logbox" id="st-log">Выберите журнал…</div>';
}
function stPhpChanged(){
  const v = $('#st-php').value;
  api('/api/php').then(p => {
    const mods = p.versions[v] || [];
    $('#st-mods').innerHTML = mods.map(m => '<label class="check" style="margin:4px 0"><input type="checkbox" class="st-mod" value="'+esc(m)+'"> ' + esc(m) + '</label>').join('');
  }).catch(()=>{});
}
async function siteSave(){
  const s = window._site;
  const body = {
    id: s.id,
    webserver: $('#st-ws') ? $('#st-ws').value : s.webserver,
    enabled: $('#st-enabled') ? $('#st-enabled').checked : s.enabled,
    php: $('#st-php') ? $('#st-php').value : s.php,
    php_modules: $('#st-mods') ?
      Array.from(document.querySelectorAll('.st-mod:checked')).map(c => c.value) : (s.php_modules||[]),
    fpm: $('#st-fpm-mc') ? {pm: $('#st-fpm-pm').value, max_children: +$('#st-fpm-mc').value,
      start_servers: +$('#st-fpm-ss').value, min_spare: s.fpm?s.fpm.min_spare:2,
      max_spare: s.fpm?s.fpm.max_spare:5} : undefined,
    node: $('#st-node-en') ? {enabled: $('#st-node-en').checked,
      version: $('#st-node-v').value, port: +$('#st-node-p').value,
      script: $('#st-node-s').value} : undefined,
    perf: {
      gzip: $('#st-perf-gzip') ? $('#st-perf-gzip').checked : undefined,
      static_cache: $('#st-perf-cache') ? $('#st-perf-cache').checked : undefined,
      hsts: $('#st-perf-hsts') ? $('#st-perf-hsts').checked : undefined,
      http2: $('#st-perf-h2') ? $('#st-perf-h2').checked : undefined},
    snippets: {
      www_redirect: $('#st-snip-www') ? $('#st-snip-www').checked : undefined,
      admin_ip: $('#st-snip-admin') ? $('#st-snip-admin').value : undefined,
      upload_size: $('#st-snip-up') ? $('#st-snip-up').value : undefined},
  };
  try { const r = await api('/api/sites/update', {method:'POST', body});
    toast(esc(r.message)); closeModal(); go('sites'); } catch(e){ toastErr(e); }
}
/* вкладка «Основное» карточки сайта: единый конструктор — используется
   и при открытии, и после переключения режима обслуживания */
function stMainHtml(s){
  const perf = s.perf || {};
  const snip = s.snippets || {};
  const isNode = s.webserver === 'nginx+node';
  const hasSsl = s.ssl && s.ssl.kind !== 'none';
  return '<div class="field"><label>Домен</label><input type="text" value="' + esc(s.domain) + '" disabled></div>' +
    '<div class="field"><label>Корневая папка</label><input type="text" value="' + esc(s.docroot) + '" disabled></div>' +
    '<div class="field"><label>Веб-сервер</label><select id="st-ws">' +
      WEBSERVERS.map(w => '<option value="'+w[0]+'"'+(s.webserver===w[0]?' selected':'')+'>'+w[1]+'</option>').join('') + '</select></div>' +
    '<label class="check"><input type="checkbox" id="st-enabled"'+(s.enabled?' checked':'')+'> Сайт включён (при выключении показывает заглушку «Сайт отключён»)</label>' +
    '<div class="row"><button class="btn" onclick="openSiteFiles()">' + icon('folder',15) + ' Файлы сайта</button>' +
    '<button class="btn" onclick="wizardSubdomain(' + s.id + ', \'' + esc(s.domain) + '\')">' + icon('plus',15) + ' Добавить поддомен</button>' +
    '<button class="btn" onclick="openSite(\'' + esc(s.domain) + '\')">' + icon('ext',15) + ' Открыть сайт</button></div>' +
    '<div class="row" style="margin-top:14px">' +
    '<button class="btn ' + (s.maintenance ? 'danger' : '') + '" onclick="toggleMaintenance()">' + icon('wrench',15) +
    (s.maintenance ? 'Выключить обслуживание' : 'Режим обслуживания (503)') + '</button>' +
    '<button class="btn" onclick="siteAuditDlg()">' + icon('shield',15) + ' Проверка здоровья сайта</button></div>' +
    (s.maintenance ? '<div class="notice warn" style="margin-top:10px">Сайт сейчас отдаёт HTTP 503 и страницу «ведутся работы».</div>' : '') +
    '<label style="margin-top:16px">Производительность (настройки nginx)</label>' +
    '<label class="check"><input type="checkbox" id="st-perf-gzip"'+(perf.gzip?' checked':'')+'> Сжатие ответов (gzip) — страницы отдаются быстрее</label>' +
    (isNode ? '' :
    '<label class="check"><input type="checkbox" id="st-perf-cache"'+(perf.static_cache?' checked':'')+'> Кэш картинок и стилей в браузере (30 дней)</label>') +
    (hasSsl ?
    '<label class="check"><input type="checkbox" id="st-perf-hsts"'+(perf.hsts?' checked':'')+'> HSTS — браузер будет ходить на сайт только по HTTPS</label>' +
    '<label class="check"><input type="checkbox" id="st-perf-h2"'+(perf.http2?' checked':'')+'> HTTP/2 — ускорение загрузки при HTTPS</label>' : '') +
    '<div class="faint" style="font-size:11.5px;margin-top:4px">Применится после «Сохранить». Конфиг проверяется nginx -t — при ошибке панель откатит изменения сама.</div>' +
    '<label style="margin-top:16px">Библиотека сниппетов (nginx)</label>' +
    '<label class="check"><input type="checkbox" id="st-snip-www"'+(snip.www_redirect?' checked':'')+'> Редирект www → без www</label>' +
    '<div class="field" style="margin:6px 0 0"><label>Закрыть /admin по IP (через запятую, пусто — выключено)</label>' +
    '<input type="text" id="st-snip-admin" class="mono" value="' + esc(snip.admin_ip || '') + '" placeholder="1.2.3.4, 5.6.7.8"></div>' +
    '<div class="field" style="margin:6px 0 0"><label>Максимум загрузки файлов (client_max_body_size)</label>' +
    '<select id="st-snip-up">' +
    ['', '64m', '128m', '256m', '512m', '1g', '2g'].map(v =>
      '<option value="' + v + '"' + ((snip.upload_size || '') === v ? ' selected' : '') + '>' +
      (v || 'по умолчанию (64m)') + '</option>').join('') + '</select></div>';
}
async function toggleMaintenance(){
  const s = window._site;
  try {
    const r = await api('/api/sites/maintenance', {method:'POST',
      body:{id: s.id, enabled: !s.maintenance}});
    toast(esc(r.message));
    const d = await api('/api/sites');
    window._site = d.sites.find(x => x.id === s.id);
    siteDlgRefreshMain();
  } catch(e){ toastErr(e); }
}
async function siteDlgRefreshMain(){
  // пересобираем вкладку целиком: при включении обслуживания появляется
  // уведомление, при выключении — исчезает, галочки производительности
  // остаются на месте (раньше regex съедал их вместе с уведомлением)
  window._stMain = stMainHtml(window._site);
  stTab('main');
}
function openSite(domain){
  const d = domain || (window._site && window._site.domain);
  if (d) window.open('http://' + d, '_blank');
}
function nodeAct(action){
  const id = window._site.id;
  const call = action === 'npm' ? '/api/sites/npm' : '/api/sites/node';
  api(call, {method:'POST', body:{id, action}}).then(r => toast(esc(r.message))).catch(e => toastErr(e));
}
async function nodeLogsDlg(){
  try {
    const d = await api('/api/site/' + window._site.id + '/node_logs');
    modal('Журнал Node.js: ' + esc(window._site.domain),
      '<div class="logbox">' + esc((d.lines||[]).join('\n')) + '</div>',
      '<button class="btn" onclick="closeModal()">Закрыть</button>', true);
  } catch(e){ toastErr(e); }
}
/* ---------- заглушка для IP-адреса сервера (404 + noindex) ---------- */
async function defaultSiteDlg(){
  let d;
  try { d = await api('/api/default-site'); } catch(e){ toastErr(e); return; }
  modal('Заглушка для IP-адреса сервера',
    '<div class="notice info">Эта страница открывается при заходе на <b>IP-адрес сервера</b> ' +
    'по http и https. Она отдаётся с кодом <b>404</b> и закрыта от индексации ' +
    '(X-Robots-Tag + meta robots) — поисковики и сканеры её не сохранят. ' +
    'HTML и стили можно менять свободно.</div>' +
    '<div class="field"><label>HTML-разметка страницы (placeholder.html)</label>' +
    '<textarea id="ds-content" class="mono" rows="18" spellcheck="false" ' +
    'style="width:100%;resize:vertical;white-space:pre;font-size:12.5px">' +
    esc(d.content) + '</textarea></div>',
    '<button class="btn primary" onclick="defaultSiteSave()">' + icon('check',15) + ' Сохранить</button>' +
    '<button class="btn" onclick="closeModal()">Закрыть</button>', 2);
}
async function defaultSiteSave(){
  try {
    const r = await api('/api/default-site', {method:'POST',
      body:{content: $('#ds-content').value}});
    toast(esc(r.message)); closeModal();
  } catch(e){ toastErr(e); }
}

/* ---------- чек-лист здоровья сайта ---------- */
async function siteAuditDlg(){
  modal('Проверка здоровья сайта',
    '<div class="empty">Проверяю: HTTPS, редирект, сжатие, кэш, PHP…</div>',
    '<button class="btn" onclick="closeModal()">Отмена</button>', true);
  let r;
  try { r = await api('/api/site/' + window._site.id + '/audit'); }
  catch(e){ closeModal(); toastErr(e); return; }
  const pill = st => st === 'ok' ? '<span class="pill ok">ок</span>' :
    st === 'warn' ? '<span class="pill warn">внимание</span>' :
    st === 'fail' ? '<span class="pill err">исправить</span>' :
    '<span class="pill gray">—</span>';
  const rows = r.checks.map(c =>
    '<div class="row" style="align-items:flex-start;gap:12px;padding:9px 0;border-bottom:1px solid var(--border)">' +
    '<div style="width:96px;flex-shrink:0">' + pill(c.status) + '</div>' +
    '<div style="flex:1"><b>' + esc(c.name) + '</b>' +
    (c.detail ? '<div class="muted" style="font-size:12.5px">' + esc(c.detail) + '</div>' : '') +
    (c.hint ? '<div class="notice info" style="margin-top:6px;font-size:12.5px">' + esc(c.hint) + '</div>' : '') +
    '</div></div>').join('');
  const scoreCls = r.score >= 80 ? 'ok' : r.score >= 50 ? 'warn' : 'err';
  modal('Проверка здоровья: ' + esc(window._site.domain),
    '<div class="row" style="align-items:center;gap:12px;margin-bottom:6px">' +
    '<span class="pill ' + scoreCls + '" style="font-size:14px">оценка: ' + r.score + '/100</span>' +
    (r.demo ? '<span class="pill gray">демо-режим</span>' : '') +
    '<span class="muted" style="font-size:12.5px">проверено: ' + r.checks.length + '</span></div>' + rows,
    '<button class="btn primary" onclick="closeModal()">Понятно</button>', true);
}
async function sslIssue(kind){
  if (kind === 'letsencrypt') {
    let dns = null;
    try { dns = await api('/api/site/' + window._site.id + '/dns_check'); }
    catch(e) {}
    if (dns && !dns.dns_ok) {
      const serverIp = esc((dns.server_ips || []).join(', ') || 'см. «Обзор»');
      confirmDlg('Домен ещё не указывает на сервер',
        'A-запись домена <b>' + esc(window._site.domain) + '</b> пока не указывает ' +
        'на IP этого сервера (' + serverIp + '). Выпуск Let\'s Encrypt почти наверняка ' +
        'провалится. Сначала настройте DNS у регистратора (изменения применяются ' +
        'до нескольких часов). Всё равно попробовать?',
        () => sslIssueGo(kind), false);
      return;
    }
  }
  sslIssueGo(kind);
}
function sslIssueGo(kind){
  const email = kind==='letsencrypt' ? (prompt('E-mail для уведомлений Let\'s Encrypt (можно пропустить):') || '') : '';
  api('/api/sites/ssl', {method:'POST', body:{id: window._site.id, kind, email}})
    .then(r => { toast(esc(r.message)); return api('/api/sites'); })
    .then(d => { window._site = d.sites.find(x => x.id === window._site.id);
      window._stSsl = sslBlockHtml(window._site); stTab('ssl'); })
    .catch(e => toastErr(e));
}
function sslDel(){
  confirmDlg('Удалить сертификат', 'Сертификат сайта <b>' + esc(window._site.domain) + '</b> будет удалён.',
    async () => {
      try { const r = await api('/api/sites/ssl_delete', {method:'POST', body:{id: window._site.id}});
        toast(esc(r.message));
        const d = await api('/api/sites');
        window._site = d.sites.find(x => x.id === window._site.id);
        window._stSsl = sslBlockHtml(window._site); stTab('ssl');
      } catch(e){ toastErr(e); }
    });
}

/* ---------- вкладка: статистика ---------- */
async function loadSiteStats(){
  try {
    const d = await api('/api/site/' + window._site.id + '/stats');
    const st = d.stats;
    const labels = st.series.map(x => x.day.slice(8) + '.' + x.day.slice(5,7));
    const html =
      '<div class="grid g4" style="margin-bottom:12px">' +
      statCard('activity','c1', st.requests.toLocaleString('ru-RU'), 'Запросов всего', null) +
      statCard('up','c2', fmtSize(st.bytes), 'Трафик', null) +
      statCard('globe','c3', st.top_ips.length, 'Активных IP (топ-10)', null) +
      statCard('file','c4', (st.codes.find(c=>c[0]==='404')||[0,0])[1] + ' / ' + (st.codes.find(c=>c[0]==='500')||[0,0])[1], 'Ошибок 404 / 500', null) +
      '</div><canvas id="st-chart" class="chart"></canvas>' +
      '<div class="split" style="margin-top:12px"><div><b class="muted" style="font-size:12.5px">Популярные страницы</b>' +
      (st.top_urls.map(u => '<div class="row" style="justify-content:space-between;font-size:12.5px;padding:3px 0">' +
        '<span class="mono">' + esc(u[0]) + '</span><span class="pill gray">' + u[1] + '</span></div>').join('') || '<div class="empty">нет данных</div>') +
      '</div><div><b class="muted" style="font-size:12.5px">Активные IP</b>' +
      (st.top_ips.map(u => '<div class="row" style="justify-content:space-between;font-size:12.5px;padding:3px 0">' +
        '<span class="mono">' + esc(u[0]) + '</span><span class="pill gray">' + u[1] + '</span></div>').join('') || '<div class="empty">нет данных</div>') +
      '</div></div>';
    $('#st-body').innerHTML = html;
    drawLine($('#st-chart'),
      [{data: st.series.map(x => x.requests), color: cssVar('--primary'), fill:true},
       {data: st.series.map(x => x.bytes/1024/1024), color: cssVar('--info')}],
      {labels: [labels[0], labels[labels.length-1]]});
  } catch(e){ $('#st-body').innerHTML = '<div class="empty">нет данных: ' + esc(e.message) + '</div>'; }
}

/* ---------- вкладка: нагрузка ---------- */
async function loadSiteLoad(){
  try {
    const d = await api('/api/site/' + window._site.id + '/load');
    const l = d.load;
    const t = l.total || {cpu:0, mem_mb:0, php_workers:0};
    let html =
      '<div class="grid g4" style="margin-bottom:12px">' +
      statCard('cpu','c1', t.cpu + '%','CPU сайта (PHP + Node)', Math.min(100,t.cpu), t.cpu>80?'err':t.cpu>50?'warn':'ok') +
      statCard('server','c2', fmtSize(t.mem_mb*1024*1024),'Память сайта', null) +
      statCard('gear','c3', t.php_workers,'PHP-воркеров', null) +
      statCard('activity','c4', l.node ? 'работает' : '—','Node.js', null) +
      '</div>';
    html += '<div class="card" style="margin:0"><div class="card-h"><span class="card-t">Процессы PHP-FPM пула</span></div>';
    if (l.php.length) {
      html += '<div class="twrap"><table><thead><tr><th>PID</th><th>CPU %</th><th>Память</th><th>Время работы</th></tr></thead><tbody>' +
        l.php.map(p => '<tr><td class="mono">' + p.pid + '</td><td>' + p.cpu + '</td><td>' + p.mem_mb + ' МБ</td><td class="mono">' + esc(p.time) + '</td></tr>').join('') +
        '</tbody></table></div>';
    } else html += '<div class="empty">воркеров нет (сайт без PHP или нет запросов)</div>';
    html += '</div>';
    $('#st-body').innerHTML = html;
  } catch(e){ $('#st-body').innerHTML = '<div class="empty">' + esc(e.message) + '</div>'; }
}

/* ---------- вкладка: живучесть ---------- */
async function loadSiteHealth(){
  try {
    const d = await api('/api/site/' + window._site.id + '/health');
    const h = d.report;
    let html = '<div class="grid g4" style="margin-bottom:12px">' +
      statCard('activity','c1', h.uptime_24h != null ? h.uptime_24h + '%' : '—','Доступность 24 ч', h.uptime_24h||0,
        h.uptime_24h>=99.5?'ok':h.uptime_24h>=97?'warn':'err') +
      statCard('stat','c2', h.uptime_7d != null ? h.uptime_7d + '%' : '—','Доступность 7 дней', h.uptime_7d||0,
        h.uptime_7d>=99.5?'ok':h.uptime_7d>=97?'warn':'err') +
      statCard('clock','c3', (h.avg_ms||0) + ' мс','Средний ответ', null) +
      statCard('shield','c4', (h.incidents||[]).length,'Инцидентов', null) +
      '</div><canvas id="st-health" class="chart sm"></canvas>' +
      '<div class="card" style="margin:12px 0 0"><div class="card-h"><span class="card-t">Инциденты</span></div>';
    if ((h.incidents||[]).length) {
      html += '<div class="twrap"><table><thead><tr><th>Начало</th><th>Конец</th></tr></thead><tbody>' +
        h.incidents.map(i => '<tr><td class="mono">' + esc(fmtDate(i.start)) + '</td><td class="mono">' +
          (i.end ? esc(fmtDate(i.end)) : '<span class="pill err">продолжается</span>') + '</td></tr>').join('') +
        '</tbody></table></div>';
    } else html += '<div class="empty">инцидентов не зафиксировано</div>';
    html += '</div>';
    $('#st-body').innerHTML = html;
    drawUptime(document.getElementById('st-health'), h.series || []);
  } catch(e){ $('#st-body').innerHTML = '<div class="empty">' + esc(e.message) + '</div>'; }
}

/* ---------- вкладка: конфиги ---------- */
async function loadSiteConf(kind){
  const s = window._site;
  const tabs = [
    ['nginx','nginx.conf'], ['apache','apache.conf'],
    ['fpm','пул FPM'], ['php','php.ini сайта']];
  let html = '<div class="row" style="margin-bottom:10px">' +
    tabs.filter(t => t[0] !== 'apache' || s.webserver.includes('apache')).map(t =>
      '<button class="btn sm' + (t[0]===kind?' primary':'') + '" onclick="loadSiteConf(\'' + t[0] + '\')">' + t[1] + '</button>').join('') +
    '</div><div class="notice info" style="margin-bottom:10px">Перед сохранением панель проверяет конфиг (nginx -t / apachectl configtest / правила php.ini). При ошибке файл откатывается.</div>' +
    '<div id="conf-editor">' + '<div class="empty">Загрузка…</div>' + '</div>' +
    '<div class="row" style="margin-top:10px"><button class="btn primary" onclick="saveSiteConf(\'' + kind + '\')">' +
    icon('check',14) + ' Сохранить и применить</button></div>';
  $('#st-body').innerHTML = html;
  try {
    const d = await api('/api/site/' + s.id + '/conf?kind=' + kind);
    window._confPath = d.path;
    $('#conf-editor').innerHTML =
      '<div class="faint mono" style="font-size:11.5px;margin-bottom:6px">' + esc(d.path) + '</div>' +
      '<div id="conf-wrap"></div>';
    window._confApi = mountCodeEditor(document.getElementById('conf-wrap'),
      d.content || '', prismLangFromKind(kind));
  } catch(e){
    window._confApi = null;  // без этого «Сохранить» перезапишет конфиг старым содержимым
    $('#conf-editor').innerHTML = '<div class="notice err">' + esc(e.message) + '</div>';
  }
}
async function saveSiteConf(kind){
  if (!window._confApi) { toast('Редактор не загружен — сохранение отменено', 'warn'); return; }
  const content = window._confApi.get();
  try {
    const r = await api('/api/site/' + window._site.id + '/conf', {method:'POST',
      body:{kind, content}});
    toast(esc(r.message));
  } catch(e){ toastErr(e); }
}

/* ---------- вкладка: фильтры (Cloudflare-подобные) ---------- */
async function loadSiteSecurity(){
  try {
    const d = await api('/api/site/' + window._site.id + '/security');
    const sec = d.security;
    const countries = d.countries || {};
    window._secCountries = countries;
    const geoOpts = Object.keys(countries).map(c =>
      '<option value="' + c + '">' + c + ' — ' + esc(countries[c]) + '</option>').join('');
    const chips = (sec.geo_countries||[]).map(c =>
      '<span class="chip">' + c + ' · ' + esc(countries[c]||'') +
      '<button onclick="secRemoveCountry(\'' + c + '\')">×</button></span>').join('');
    const ipChips = (list, kind) => (list||[]).map(ip =>
      '<span class="chip mono">' + esc(ip) + '<button onclick="secRemoveIp(\'' + kind + '\', \'' + ip + '\')">×</button></span>').join('');
    $('#st-body').innerHTML =
      '<div class="notice info">Правила применяются к сайту на уровне nginx: гео-страны (GeoIP2), списки IP, блокировка ботов и сканеров, базовый WAF (SQLi/XSS/скрытые файлы), ограничение частоты запросов.</div>' +
      '<label>Доступ по странам</label>' +
      '<div class="row"><select id="sec-geo-mode">' +
      '<option value="off"' + (sec.geo_mode==='off'?' selected':'') + '>— все страны —</option>' +
      '<option value="allow"' + (sec.geo_mode==='allow'?' selected':'') + '>разрешить только выбранные</option>' +
      '<option value="deny"' + (sec.geo_mode==='deny'?' selected':'') + '>запретить выбранные</option></select>' +
      '<div style="flex:1;min-width:200px"><select id="sec-geo-country" onchange="secAddCountry()">' +
      '<option value="">+ добавить страну…</option>' + geoOpts + '</select></div></div>' +
      '<div class="chips" id="sec-geo-chips" style="margin-top:8px">' + (chips || '<span class="faint" style="font-size:12.5px">страны не выбраны</span>') + '</div>' +
      (d.geo_available ? '' : '<div class="notice warn" style="margin-top:10px">Модуль nginx geoip2 не найден: установите <span class="mono">apt install libnginx-mod-http-geoip2</span> и базы GeoLite2.</div>') +
      '<label style="margin-top:14px">Запрещённые IP (чёрный список)</label>' +
      '<div class="row"><input type="text" id="sec-ip-deny" placeholder="например, 45.155.205.11" style="flex:1">' +
      '<button class="btn sm" onclick="secAddIp(\'deny\')">Добавить</button></div>' +
      '<div class="chips" id="sec-deny-chips" style="margin-top:8px">' + (ipChips(sec.ip_deny,'deny') || '<span class="faint" style="font-size:12.5px">пусто</span>') + '</div>' +
      '<label style="margin-top:14px">Разрешённые IP (белый список; при непустом — только они)</label>' +
      '<div class="row"><input type="text" id="sec-ip-allow" placeholder="например, 10.0.0.5" style="flex:1">' +
      '<button class="btn sm" onclick="secAddIp(\'allow\')">Добавить</button></div>' +
      '<div class="chips" id="sec-allow-chips" style="margin-top:8px">' + (ipChips(sec.ip_allow,'allow') || '<span class="faint" style="font-size:12.5px">пусто</span>') + '</div>' +
      '<div class="row" style="margin-top:14px">' +
      '<label class="check" style="margin:0"><input type="checkbox" id="sec-bots"' + (sec.block_bots?' checked':'') + '> Блокировать ботов и сканеры</label>' +
      '<label class="check" style="margin:0"><input type="checkbox" id="sec-waf"' + (sec.waf?' checked':'') + '> Включить WAF (SQLi / XSS / скрытые файлы)</label></div>' +
      '<label style="margin-top:14px">Ограничение частоты запросов (защита от DDoS)</label>' +
      '<div class="row"><div class="field" style="flex:1"><label style="margin-top:0">Запросов/сек (0 = выкл.)</label>' +
      '<input type="number" id="sec-rate" value="' + (sec.rate_limit||0) + '"></div>' +
      '<div class="field" style="flex:1"><label style="margin-top:0">Всплеск (burst)</label>' +
      '<input type="number" id="sec-burst" value="' + (sec.rate_burst||20) + '"></div></div>' +
      '<div class="row" style="margin-top:14px"><button class="btn primary" onclick="secSave()">' + icon('check',14) + ' Применить фильтры</button></div>';
    window._sec = sec;
  } catch(e){ $('#st-body').innerHTML = '<div class="empty">' + esc(e.message) + '</div>'; }
}
function secAddCountry(){
  const sel = $('#sec-geo-country');
  if (!sel.value) return;
  const c = sel.value;
  if (!window._sec.geo_countries.includes(c)) window._sec.geo_countries.push(c);
  sel.value = '';
  loadSiteSecurity();
}
function secRemoveCountry(c){
  window._sec.geo_countries = window._sec.geo_countries.filter(x => x !== c);
  loadSiteSecurity();
}
function secAddIp(kind){
  const input = $(kind === 'deny' ? '#sec-ip-deny' : '#sec-ip-allow');
  const ip = input.value.trim();
  if (!ip) return;
  const list = window._sec['ip_' + kind] || [];
  if (!list.includes(ip)) list.push(ip);
  window._sec['ip_' + kind] = list;
  loadSiteSecurity();
}
function secRemoveIp(kind, ip){
  window._sec['ip_' + kind] = (window._sec['ip_' + kind] || []).filter(x => x !== ip);
  loadSiteSecurity();
}
async function secSave(){
  const sec = {
    geo_mode: $('#sec-geo-mode').value,
    geo_countries: window._sec.geo_countries,
    ip_allow: window._sec.ip_allow || [],
    ip_deny: window._sec.ip_deny || [],
    block_bots: $('#sec-bots').checked,
    waf: $('#sec-waf').checked,
    rate_limit: +$('#sec-rate').value,
    rate_burst: +$('#sec-burst').value,
  };
  try {
    const r = await api('/api/sites/security', {method:'POST',
      body:{id: window._site.id, security: sec}});
    toast(esc(r.message));
  } catch(e){ toastErr(e); }
}

/* ---------- вкладка: логи с фильтрами ---------- */
async function siteLog(kind){
  window._logKind = kind;
  let d;
  try { d = await api('/api/site/' + window._site.id + '/logs?type=' + kind); }
  catch(e){ toastErr(e); return; }
  renderLogBox(d, kind);
  // перерисовываем панель фильтров
  const fb = document.getElementById('log-filters');
  if (!fb) {
    $('#st-body').insertAdjacentHTML('afterbegin',
      '<div class="filter-bar" id="log-filters">' +
      '<div class="f grow"><label style="margin:0 0 4px">Поиск по тексту</label><input type="text" id="lf-q" oninput="applyLogFilters()" placeholder="подстрока в строке лога"></div>' +
      '<div class="f"><label style="margin:0 0 4px">Код</label><select id="lf-code" onchange="applyLogFilters()"><option value="">все</option>' +
      ['200','301','302','304','403','404','429','500','502','503'].map(c => '<option>'+c+'</option>').join('') + '</select></div>' +
      '<div class="f"><label style="margin:0 0 4px">IP</label><input type="text" id="lf-ip" oninput="applyLogFilters()" placeholder="1.2.3.4"></div>' +
      '<div class="f"><label style="margin:0 0 4px">URL содержит</label><input type="text" id="lf-url" oninput="applyLogFilters()" placeholder="/wp-admin"></div>' +
      '<div class="f"><label style="margin:0 0 4px">С даты</label><input type="date" id="lf-since" onchange="applyLogFilters()"></div>' +
      '<div class="f"><label style="margin:0 0 4px">По дату</label><input type="date" id="lf-until" onchange="applyLogFilters()"></div>' +
      '<label class="check" style="margin:0"><input type="checkbox" id="lf-err" onchange="applyLogFilters()"> только ошибки (4xx/5xx)</label>' +
      '<label class="check" style="margin:0"><input type="checkbox" id="lf-bots" onchange="applyLogFilters()"> только боты</label>' +
      '<button class="btn sm" onclick="siteLog(window._logKind)">' + icon('refresh',13) + ' Обновить</button>' +
      '</div>');
  }
}
function renderLogBox(d, kind){
  let box = document.getElementById('st-log');
  if (!box) return;
  const lines = d.lines || [];
  box.innerHTML = lines.length ? lines.map(l => {
    if (/\[error\]| 500 | 502 | 503 | 40[0-9] /.test(l)) {
      if (kind === 'error' || / 5\d\d /.test(l)) return '<span class="le">' + esc(l) + '</span>';
      if (/ 40\d /.test(l)) return '<span class="lw">' + esc(l) + '</span>';
    }
    return esc(l);
  }).join('\n') : 'пусто';
  box.scrollTop = box.scrollHeight;
  const meta = document.getElementById('log-meta');
  if (meta) meta.textContent = 'показано ' + lines.length + ' из ' + (d.total||0) + ' строк';
}
async function applyLogFilters(){
  const p = new URLSearchParams();
  p.set('type', window._logKind || 'access');
  if ($('#lf-q') && $('#lf-q').value) p.set('q', $('#lf-q').value);
  if ($('#lf-code') && $('#lf-code').value) p.set('code', $('#lf-code').value);
  if ($('#lf-ip') && $('#lf-ip').value) p.set('ip', $('#lf-ip').value);
  if ($('#lf-url') && $('#lf-url').value) p.set('url', $('#lf-url').value);
  if ($('#lf-since') && $('#lf-since').value) p.set('since', $('#lf-since').value);
  if ($('#lf-until') && $('#lf-until').value) p.set('until', $('#lf-until').value);
  if ($('#lf-err') && $('#lf-err').checked) p.set('errors_only', '1');
  if ($('#lf-bots') && $('#lf-bots').checked) p.set('bots_only', '1');
  try {
    const d = await api('/api/site/' + window._site.id + '/logs?' + p.toString());
    renderLogBox(d, window._logKind || 'access');
  } catch(e){ toastErr(e); }
}
function openSiteFiles(){
  const dom = window._site.domain;
  closeModal();
  go('files');
  setTimeout(() => { window._fmGo(window._site.docroot); }, 300);
}

/* ---------- страница: Базы данных (MariaDB и PostgreSQL) ---------- */
async function pgDbs(c){
  c.innerHTML = '<div class="empty">Загрузка…</div>';
  let d;
  try { d = await api('/api/db'); } catch(e){ c.innerHTML=''; toastErr(e); return; }
  window._dbEngines = d.engines || [];
  const avail = window._dbEngines.filter(e => e.available);
  if (!avail.length) {
    c.innerHTML =
      '<div class="hintbox">' + icon('db',16) + '<div>База данных — это «хранилище», куда сайт ' +
      'складывает свою информацию: товары, записи, пользователей. Она нужна большинству сайтов ' +
      '(интернет-магазины, блоги, форумы).</div></div>' +
      '<div class="card" style="text-align:center;padding:46px 20px">' +
      '<div class="empty" style="padding:0 0 14px">Сервер баз данных (MariaDB или PostgreSQL) ещё не установлен</div>' +
      '<button class="btn primary" onclick="go(\'software\')">Перейти в «Установка ПО»</button></div>';
    return;
  }
  const engName = id => { const e = window._dbEngines.find(x => x.id === id); return e ? e.name : id; };
  window._dbEngName = engName;
  const filt = window._dbFilter && (window._dbFilter === 'all' ||
    avail.some(e => e.id === window._dbFilter)) ? window._dbFilter : 'all';
  window._dbFilter = filt;
  const dbs = d.dbs.filter(x => filt === 'all' || (x.engine || 'mysql') === filt);
  const tabs = ['<button class="btn sm' + (filt === 'all' ? ' primary' : '') +
    '" onclick="dbFilterSet(\'all\')">Все (' + d.dbs.length + ')</button>']
    .concat(avail.map(e => '<button class="btn sm' + (filt === e.id ? ' primary' : '') +
      '" onclick="dbFilterSet(\'' + e.id + '\')">' + esc(e.name) + ' (' +
      d.dbs.filter(x => (x.engine || 'mysql') === e.id).length + ')</button>'))
    .concat(window._dbEngines.filter(e => !e.available).map(e =>
      '<span class="pill warn" style="cursor:pointer" title="Установить в разделе «Установка ПО»" onclick="go(\'software\')">' +
      esc(e.name) + ' не установлен — установить</span>'));
  const rows = dbs.map(db => {
    const u = db.user ? esc(db.user) : '';
    const eng = db.engine || 'mysql';
    return '<tr><td><b class="mono">' + esc(db.name) + '</b></td>' +
      '<td><span class="pill ' + (eng === 'pg' ? 'info' : 'gray') + '">' + esc(engName(eng)) + '</span></td>' +
      '<td>' + (u ? '<span class="mono">' + u + '</span>' : '<span class="faint">—</span>') + '</td>' +
      '<td>' + (db.tables || 0) + '</td>' +
      '<td>' + fmtSize(db.size_bytes) + '</td>' +
      '<td><div class="actions-cell">' +
      '<a class="btn sm" title="Скачать дамп базы (.sql)" href="/api/db/export?name=' + encodeURIComponent(db.name) +
      '&engine=' + encodeURIComponent(eng) + '">' + icon('down',14) + ' Экспорт</a>' +
      '<button class="btn sm" title="Загрузить SQL-файл в базу" onclick="dbImportDlg(\'' + esc(db.name) + '\', \'' + eng + '\')">' + icon('up',14) + ' Импорт</button>' +
      '<button class="btn sm" title="Изменить пароль" onclick="dbPassDlg(\'' + esc(db.name) + '\', \'' + eng + '\')">' + icon('lock',14) + ' Пароль</button>' +
      (ME.expert ? '<button class="btn sm" title="SQL-запросы к базе" onclick="dbSqlDlg(\'' + esc(db.name) + '\', \'' + eng + '\')">' + icon('term',14) + ' SQL</button>' : '') +
      '<button class="btn sm icon danger" title="Удалить базу" onclick="dbDel(\'' + esc(db.name) + '\', \'' + eng + '\')">' + icon('trash',14) + '</button>' +
      '</div></td></tr>';
  }).join('');
  const emptyTxt = filt === 'all'
    ? 'Пока нет ни одной базы данных.<br>Если вашему сайту нужна база (например, для WordPress) — создайте её здесь.'
    : 'Баз ' + esc(engName(filt)) + ' пока нет.';
  c.innerHTML =
    '<div class="hintbox">' + icon('db',16) + '<div><b>Что такое база данных?</b> Это хранилище, ' +
    'куда сайт складывает свою информацию: товары, записи, пользователей. При установке сайта ' +
    '(WordPress, магазин и т.п.) вас попросят указать имя базы, пользователя и пароль — они появятся ' +
    'после нажатия кнопки «Создать базу». Здесь можно работать и с MariaDB, и с PostgreSQL.</div></div>' +
    '<div class="toolbar"><button class="btn primary" onclick="dbCreateDlg()">' + icon('plus',15) +
    'Создать базу</button>' +
    '<button class="btn" onclick="dbSqlDlg()">' + icon('term',15) + ' SQL-консоль</button></div>' +
    '<div class="row" style="gap:8px;margin:0 0 10px;flex-wrap:wrap">' + tabs.join('') + '</div>' +
    (dbs.length ?
      '<div class="card" style="padding:6px 10px"><div class="twrap"><table>' +
      '<thead><tr><th>Название</th><th>СУБД</th><th>Пользователь</th><th>Таблиц</th><th>Размер</th><th></th></tr></thead><tbody>' +
      rows + '</tbody></table></div></div>' +
      '<div class="faint" style="font-size:12px;margin-top:10px">Экспорт скачивает дамп базы в файл .sql — ' +
      'его можно отдать разработчику или залить на другой сервер. Импорт выполняет SQL-файл (.sql, .sql.gz, .zip) ' +
      'в выбранную базу — так переносят сайт с другого хостинга.</div>'
      :
      '<div class="card" style="text-align:center;padding:46px 20px">' +
      '<div class="empty" style="padding:0 0 14px">' + emptyTxt + '</div>' +
      '<button class="btn primary" onclick="dbCreateDlg(\'' + (filt === 'all' ? (avail[0] && avail[0].id || 'mysql') : filt) + '\')">' +
      icon('plus',15) + 'Создать базу</button></div>');
}
function dbFilterSet(f){
  window._dbFilter = f;
  go('dbs');
}
function dbCreateDlg(engine){
  const avail = (window._dbEngines || []).filter(e => e.available);
  const cur = engine || window._dbFilter || 'mysql';
  const engBlock = avail.map(e =>
    '<label class="check" style="margin:4px 0"><input type="radio" name="db-eng" value="' + e.id + '"' +
    (e.id === (avail.some(x => x.id === cur) ? cur : avail[0].id) ? ' checked' : '') + '> ' + esc(e.name) +
    (e.id === 'pg' ? ' <span class="faint">— например, для 1С-Битрикс24 или приложений на Django</span>' : '') +
    '</label>').join('');
  const auto = 'db_' + Math.random().toString(36).slice(2, 7);
  modal('Новая база данных',
    (avail.length > 1
      ? '<div class="field"><label>Тип СУБД</label>' + engBlock + '</div>'
      : '<div class="faint" style="font-size:12px;margin-bottom:8px">СУБД: <b>' + esc((avail[0] || {}).name || 'MariaDB') +
        '</b>' + (avail.length === 1 && avail[0].id === 'mysql' ? ' (PostgreSQL можно установить в разделе «Установка ПО»)' : '') + '</div>') +
    '<div class="field"><label>Название базы (латиница, цифры, _)</label>' +
    '<input type="text" id="db-name" class="mono" placeholder="например, shop_db" value="' + auto + '"></div>' +
    '<div class="field"><label>Пользователь</label>' +
    '<input type="text" id="db-user" class="mono" placeholder="например, shop_user"></div>' +
    pwField('db-pass', {label:'Пароль базы',
      hint:'Пароль понадобится при установке сайта (например, WordPress). Скопируйте его кнопкой справа.'}),
    '<button class="btn primary" onclick="dbCreate()">Создать</button><button class="btn" onclick="closeModal()">Отмена</button>');
  $('#db-user').value = auto + '_u';
  pwGenerate('db-pass');
  pwBindStrength('db-pass');
  setTimeout(() => { $('#db-name').select(); }, 60);
}
/* после создания: показать реквизиты с копированием и подсказкой «что дальше» */
async function dbCreate(){
  const engEl = document.querySelector('input[name="db-eng"]:checked');
  const availEng = (window._dbEngines || []).filter(e => e.available);
  const engine = engEl ? engEl.value :
    (availEng.length === 1 ? availEng[0].id : 'mysql');
  const name = $('#db-name').value.trim(), user = $('#db-user').value.trim(),
        pass = $('#db-pass').value;
  try {
    await api('/api/db/create', {method:'POST', body:{name, user, password: pass, engine}});
    dbCredsModal(name, user, pass, engine);
  } catch(e){ toastErr(e); }
}
function dbCredsModal(name, user, pass, engine){
  const engName = (window._dbEngName || (id => id))(engine || 'mysql');
  modal('База «' + esc(name) + '» создана',
    '<div class="notice ok">Готово! Скопируйте эти данные — они нужны при установке сайта.</div>' +
    credRow('СУБД', engName) +
    credRow('Сервер (хост)', 'localhost') +
    credRow('Название базы', name) +
    credRow('Пользователь', user) +
    credRow('Пароль', pass, 'db-cred-pass') +
    '<div class="hintbox" style="margin-top:12px">' + icon('check',16) +
    '<div><b>Что дальше?</b> Создайте сайт в разделе «Сайты» и при установке ' +
    '(например, WordPress) введите эти данные в шаге настройки базы.</div></div>',
    '<button class="btn primary" onclick="closeModal(); go(\'dbs\')">Готово</button>' +
    '<button class="btn" onclick="closeModal(); go(\'sites\'); setTimeout(wizardSite, 250)">Создать сайт →</button>');
  pgDbsRefresh();
}
function pgDbsRefresh(){ if (PAGE === 'dbs') go('dbs'); }

/* ---------- импорт SQL-дампа в базу ---------- */
function dbImportDlg(name, engine){
  modal('Импорт в базу «' + esc(name) + '»',
    '<div class="notice warn">Содержимое SQL-файла будет выполнено в базе «<b>' + esc(name) + '</b>»: ' +
    'существующие таблицы с теми же именами будут перезаписаны. Сначала сделайте экспорт текущей базы.</div>' +
    '<div class="field"><label>Файл дампа (.sql, .sql.gz, .zip — до 200 МБ)</label>' +
    '<input type="file" id="dbi-file" accept=".sql,.gz,.zip"></div>' +
    '<div id="dbi-out"></div>',
    '<button class="btn primary" onclick="dbImportRun(\'' + esc(name) + '\', \'' + engine + '\')">' +
    icon('up',15) + ' Импортировать</button>' +
    '<button class="btn" onclick="closeModal()">Отмена</button>', true);
}
async function dbImportRun(name, engine){
  const inp = document.getElementById('dbi-file');
  if (!inp || !inp.files.length) { toast('выберите файл дампа', 'warn'); return; }
  const out = document.getElementById('dbi-out');
  out.innerHTML = '<div class="empty">Импортирую — не закрывайте окно…</div>';
  const fd = new FormData();
  fd.append('name', name);
  fd.append('engine', engine);
  fd.append('file', inp.files[0]);
  try {
    const r = await fetch('/api/db/import', {method:'POST', body: fd});
    const j = await r.json();
    if (!j.ok) throw new Error(j.error || 'ошибка импорта');
    out.innerHTML = '<div class="notice ok">' + esc(j.message) + '</div>';
    setTimeout(() => { closeModal(); pgDbsRefresh(); }, 1500);
  } catch(e){
    out.innerHTML = '<div class="notice err">' + esc(e.message) + '</div>';
  }
}

/* смена пароля пользователя базы */
async function dbPassDlg(name, engine){
  engine = engine || 'mysql';
  let users = [];
  try { users = (await api('/api/db/users?name=' + encodeURIComponent(name) +
      '&engine=' + encodeURIComponent(engine))).users; }
  catch(e){}
  if (!users.length) users = [name.replace(/[^\w]/g, '').slice(0, 14) + '_u'];
  window._dbPw = {name, engine, user: users[0]};
  const opts = users.map(u => '<option value="' + esc(u) + '">' + esc(u) + '</option>').join('');
  const engName = (window._dbEngName || (id => id))(engine);
  modal('Пароль базы «' + esc(name) + '» — ' + esc(engName),
    '<div class="field"><label>Пользователь</label><select id="dbp-user" onchange="window._dbPw.user=this.value">' + opts + '</select></div>' +
    pwField('dbp-pass', {label:'Новый пароль',
      hint:'После смены пароля обновите его в настройках сайта, который использует эту базу — иначе сайт потеряет доступ.'}),
    '<button class="btn primary" onclick="dbPassSave()">Изменить пароль</button>' +
    '<button class="btn" onclick="closeModal()">Отмена</button>');
  pwGenerate('dbp-pass');
  pwBindStrength('dbp-pass');
}
async function dbPassSave(){
  try {
    await api('/api/db/pass', {method:'POST', body:{
      name: window._dbPw.name,
      user: document.getElementById('dbp-user') ? document.getElementById('dbp-user').value : window._dbPw.user,
      password: document.getElementById('dbp-pass').value,
      engine: window._dbPw.engine}});
    const pw = document.getElementById('dbp-pass').value;
    const user = document.getElementById('dbp-user') ? document.getElementById('dbp-user').value : window._dbPw.user;
    closeModal();
    modal('Пароль изменён',
      '<div class="notice ok">Новый пароль для базы <b class="mono">' + esc(window._dbPw.name) + '</b> сохранён.</div>' +
      credRow('Пользователь', user) +
      credRow('Новый пароль', pw, 'db-new-pass') +
      '<div class="hintbox" style="margin-top:12px">' + icon('lock',16) +
      '<div>Скопируйте пароль и обновите его в файле конфигурации вашего сайта (например, wp-config.php у WordPress).</div></div>',
      '<button class="btn primary" onclick="closeModal()">Готово</button>');
  } catch(e){ toastErr(e); }
}

/* ---------- SQL-консоль (MariaDB / PostgreSQL) ---------- */
async function dbSqlDlg(db, engine){
  engine = engine || (db ? null :
    ((window._dbEngines || []).filter(e => e.available)[0] || {}).id ||
    'mysql');
  let dbs = [];
  try { dbs = (await api('/api/db')).dbs; } catch(e){}
  if (db && !engine) {
    const row = dbs.find(x => x.name === db);
    engine = row ? (row.engine || 'mysql') : 'mysql';
  }
  const list = engine ? dbs.filter(x => (x.engine || 'mysql') === engine) : dbs;
  if (db) list.unshift({name: db, engine: engine || 'mysql'});
  if (!list.length) { toastErr(new Error('базы данных не найдены')); return; }
  if (!engine) engine = list[0].engine || 'mysql';
  window._sqlEngine = engine;
  window._sqlHist = window._sqlHist || [];
  const opts = list.map(x => '<option value="' + esc(x.name) + '"' +
    (x.name === db ? ' selected' : '') + '>' + esc(x.name) +
    ((x.engine || 'mysql') !== engine ? ' · ' + (window._dbEngName ? window._dbEngName(x.engine || 'mysql') : '') : '') +
    '</option>').join('');
  const hist = window._sqlHist.map((q,i) =>
    '<option value="'+i+'">' + esc(q.slice(0,60)) + (q.length>60?'…':'') + '</option>').join('');
  modal('SQL-консоль — ' + (engine === 'pg' ? 'PostgreSQL' : 'MySQL'),
    '<div class="row"><div class="field" style="flex:1"><label>База данных</label>' +
    '<select id="sql-db">' + opts + '</select></div>' +
    (hist ? '<div class="field" style="flex:1"><label>История</label>' +
      '<select id="sql-hist" onchange="window._sqlApi && document.getElementById(\'sql-text\').value=window._sqlHist[this.value]">' +
      '<option value="">—</option>' + hist + '</select></div>' : '') + '</div>' +
    '<div id="sql-wrap"></div>' +
    '<div class="faint" style="font-size:11.5px;margin-top:6px">Ctrl+Enter — выполнить. Запросы выполняются от ' +
    (engine === 'pg' ? 'администратора PostgreSQL (postgres)' : 'root MySQL') + '.</div>' +
    '<div id="sql-out" style="margin-top:10px"></div>',
    '<button class="btn primary" onclick="dbSqlRun()">' + icon('check',15) + ' Выполнить</button>' +
    '<button class="btn" onclick="closeModal()">Закрыть</button>', true);
  window._sqlApi = mountCodeEditor(document.getElementById('sql-wrap'),
    db ? (engine === 'pg' ? "SELECT table_name FROM information_schema.tables WHERE table_schema='public';" : 'SHOW TABLES;') : (engine === 'pg' ? 'SELECT version();' : 'SELECT 1;'), 'sql');
  const ta = document.querySelector('#sql-wrap .code-input');
  ta.addEventListener('keydown', e => {
    if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); dbSqlRun(); }
  });
}
async function dbSqlRun(){
  const db = document.getElementById('sql-db').value;
  const sql = window._sqlApi.get().trim();
  const out = document.getElementById('sql-out');
  if (!sql) { toast('пустой запрос', 'warn'); return; }
  if (/^\s*(DROP|TRUNCATE|DELETE|UPDATE|ALTER|RENAME)\b/i.test(sql) &&
      !window._sqlConfirmed) {
    confirmDlg('Опасная операция',
      'Запрос <b>' + esc(sql.slice(0,80)) + '</b> изменяет или удаляет данные. Выполнить?',
      () => { window._sqlConfirmed = true; dbSqlRun(); setTimeout(()=>window._sqlConfirmed=false, 500); });
    return;
  }
  out.innerHTML = '<div class="empty">Выполняется…</div>';
  try {
    const r = await api('/api/db/query', {method:'POST', body:{db, sql, engine: window._sqlEngine || 'mysql'}});
    window._sqlHist = [sql].concat(window._sqlHist.filter(q => q !== sql)).slice(0, 15);
    if (r.columns && r.columns.length) {
      out.innerHTML = '<div class="notice ok" style="margin-bottom:8px">' + esc(r.info) + '</div>' +
        '<div class="twrap" style="max-height:300px;overflow:auto"><table><thead><tr>' +
        r.columns.map(c => '<th class="mono">' + esc(c) + '</th>').join('') +
        '</tr></thead><tbody>' +
        r.rows.map(row => '<tr>' + row.map(cell => '<td class="mono">' + esc(cell) + '</td>').join('') + '</tr>').join('') +
        '</tbody></table></div>';
    } else {
      out.innerHTML = '<div class="notice ok">' + esc(r.info || 'выполнено') + '</div>';
    }
  } catch(e) {
    out.innerHTML = '<div class="notice err">' + esc(e.message) + '</div>';
  }
}
/* genPass — старое имя генератора (почта), теперь общий из core.js */
function genPass(){ return genPassword(); }
function dbDel(name, engine){
  confirmDlg('Удалить базу', 'База <b>' + esc(name) + '</b> и её данные будут удалены безвозвратно.',
    async () => { try { const r = await api('/api/db/delete', {method:'POST', body:{name, engine: engine || 'mysql'}});
      toast(esc(r.message)); go('dbs'); } catch(e){ toastErr(e); } });
}

/* ==================== ПОЧТА: домены и ящики ==================== */
async function pgMail(c){
  c.innerHTML = '<div class="empty">Загрузка…</div>';
  let d;
  try { d = await api('/api/mail'); } catch(e){ c.innerHTML=''; toastErr(e); return; }
  const st = d.status;
  const pill = (on, label) => '<span class="pill ' + (on?'ok':'err') + '"><span class="dot"></span>' +
    (on?label+' работает':label+' остановлен') + '</span>';
  let html =
    '<div class="card" style="padding:14px"><div class="row" style="align-items:center;flex-wrap:wrap;gap:8px">' +
    '<div class="row" style="align-items:center;gap:8px;flex-wrap:wrap"><b>Почтовый сервер</b>' +
    pill(st.postfix_active,'Postfix') + pill(st.dovecot_active,'Dovecot') + '</div>' +
    '<span class="spacer"></span>' +
    '<span class="muted" style="font-size:13px">доменов: <b>' + st.domains + '</b> · ящиков: <b>' + st.mailboxes + '</b></span></div>' +
    '<div class="notice info" style="margin-top:10px">SMTP: порт 25 и 587 (авторизация) · IMAP: 143/993 · POP3: 110/995. ' +
    'Для приёма внешней почты добавьте у регистратора MX-запись домена на этот сервер ' +
    '(A-запись: ' + esc((st.server_ips||[]).join(', ')||'IP сервера') + ').</div></div>';
  if (!st.postfix_installed || !st.dovecot_installed) {
    c.innerHTML = html +
      '<div class="notice warn" style="margin-top:12px">Почтовые службы ещё не установлены.</div>' +
      '<div class="row" style="margin-top:10px">' +
      '<button class="btn primary" onclick="mailInstallAll()">' + icon('down',15) + ' Установить Postfix + Dovecot + Mailutils</button></div>';
    return;
  }
  /* --- домены --- */
  html += '<div class="card" style="margin-top:12px;padding:6px 10px">' +
    '<div class="card-h" style="padding:10px 6px 0"><span class="card-t">Почтовые домены</span>' +
    '<span class="card-spacer"></span>' +
    '<button class="btn sm primary" onclick="mailDomainDlg()">' + icon('plus',14) + ' Добавить домен</button>' +
    '<span class="faint" style="font-size:11.5px">у каждого домена кнопка «DNS» — готовые SPF/DKIM/DMARC записи для регистратора</span></div>' +
    '<div class="twrap"><table><thead><tr><th>Домен</th><th>Добавлен</th><th>Ящиков</th><th></th></tr></thead><tbody>' +
    (d.domains.length ? d.domains.map(dm => {
      const cnt = d.mailboxes.filter(m => m.domain === dm.domain).length;
      return '<tr><td class="mono"><b>' + esc(dm.domain) + '</b></td>' +
        '<td class="muted">' + esc(fmtDate(dm.created)) + '</td><td>' + cnt + '</td>' +
        '<td><div class="actions-cell">' +
        '<button class="btn sm" onclick="mailBoxDlg(\'' + esc(dm.domain) + '\')">' + icon('plus',13) + ' Ящик</button>' +
        '<button class="btn sm" onclick="mailDnsDlg(\'' + esc(dm.domain) + '\')">DNS (SPF/DKIM)</button>' + '<button class="btn sm icon danger" onclick="mailDomainDel(\'' + esc(dm.domain) + '\')">' + icon('trash',14) + '</button>' +
        '</div></td></tr>';
    }).join('') : '<tr><td colspan="4" class="muted">доменов нет</td></tr>') +
    '</tbody></table></div></div>';
  /* --- ящики --- */
  html += '<div class="card" style="margin-top:12px;padding:6px 10px">' +
    '<div class="card-h" style="padding:10px 6px 0"><span class="card-t">Ящики</span>' +
    '<span class="card-spacer"></span>' +
    '<button class="btn sm primary" onclick="mailBoxDlg()">' + icon('plus',14) + ' Создать ящик</button></div>' +
    '<div class="twrap"><table><thead><tr><th>Ящик</th><th>Домен</th><th>Создан</th><th></th></tr></thead><tbody>' +
    (d.mailboxes.length ? d.mailboxes.map(m =>
      '<tr><td class="mono"><b>' + esc(m.email) + '</b></td>' +
      '<td class="muted">' + esc(m.domain) + '</td>' +
      '<td class="muted">' + esc(fmtDate(m.created)) + '</td>' +
      '<td><div class="actions-cell">' +
      '<button class="btn sm" onclick="mailBoxTest(\'' + esc(m.email) + '\')">Тест доставки</button>' +
      '<button class="btn sm" onclick="mailBoxPwDlg(\'' + esc(m.email) + '\')">Пароль</button>' +
      '<button class="btn sm icon danger" onclick="mailBoxDel(\'' + esc(m.email) + '\')">' + icon('trash',14) + '</button>' +
      '</div></td></tr>').join('') : '<tr><td colspan="4" class="muted">ящиков нет</td></tr>') +
    '</tbody></table></div>' +
    '<div class="muted" style="font-size:12.5px;padding:8px 6px">Настройки почтового клиента: сервер входящей почты IMAP — ' +
    esc(location.hostname) + ', порт 143 (SSL 993); SMTP — порт 587; логин и пароль — как у ящика.</div></div>';
  c.innerHTML = html;
}
async function mailInstallAll(){
  confirmDlg('Установка почты', 'Установить <b>Postfix, Dovecot и Mailutils</b>? Займёт 1–3 минуты.',
    async () => {
      for (const n of ['postfix','dovecot','mailutils']) {
        try { const r = await api('/api/software/install', {method:'POST', body:{name:n}}); }
        catch(e){ toastErr(e); return; }
        for (let i = 0; i < 150; i++) {  // ждём завершения фоновой задачи
          await new Promise(r2 => setTimeout(r2, 2000));
          try { const t = await api('/api/packages/task'); if (!t.running) break; } catch(e2){}
        }
      }
      toast('Почтовый стек установлен');
      go('mail');
    });
}
function mailDomainDlg(){
  modal('Почтовый домен',
    '<div class="field"><label>Домен (MX-запись должна указывать на этот сервер)</label>' +
    '<input type="text" id="md-domain" placeholder="example.ru"></div>' +
    '<div class="notice info">Панель пропишет домен в Postfix; ящики создаются на следующем шаге.</div>',
    '<button class="btn primary" onclick="mailDomainAdd()">Добавить</button>' +
    '<button class="btn" onclick="closeModal()">Отмена</button>');
}
async function mailDomainAdd(){
  try { const r = await api('/api/mail/domains/add', {method:'POST',
      body:{domain: document.getElementById('md-domain').value.trim()}});
    toast(esc(r.message)); closeModal(); go('mail'); }
  catch(e){ toastErr(e); }
}
function mailDomainDel(domain){
  confirmDlg('Удалить домен', 'Удалить почтовый домен <b>' + esc(domain) + '</b>? ' +
    'Сначала нужно удалить все его ящики.',
    async () => { try { const r = await api('/api/mail/domains/remove', {method:'POST', body:{domain}});
      toast(esc(r.message)); go('mail'); } catch(e){ toastErr(e); } });
}
function mailBoxDlg(domain){
  modal('Новый ящик',
    '<div class="field"><label>Локальная часть (до @)</label><input type="text" id="mb-local" placeholder="info"></div>' +
    '<div class="field"><label>Домен</label><select id="mb-domain"></select></div>' +
    pwField('mb-pass', {label:'Пароль (мин. 6 символов)',
      hint:'Этот пароль вводится в почтовом клиенте. Скопируйте его кнопкой справа.'}),
    '<button class="btn primary" onclick="mailBoxAdd()">Создать</button>' +
    '<button class="btn" onclick="closeModal()">Отмена</button>');
  api('/api/mail').then(d => {
    document.getElementById('mb-domain').innerHTML = d.domains.map(x =>
      '<option' + (x.domain===domain?' selected':'') + '>' + esc(x.domain) + '</option>').join('') ||
      '<option value="">— сначала добавьте домен —</option>';
  }).catch(()=>{});
  pwGenerate('mb-pass');
  pwBindStrength('mb-pass');
}
async function mailBoxAdd(){
  const email = document.getElementById('mb-local').value.trim() + '@' +
    document.getElementById('mb-domain').value;
  try {
    const r = await api('/api/mail/boxes/add', {method:'POST',
      body:{email, password: document.getElementById('mb-pass').value}});
    modal('Ящик создан',
      '<div class="notice ok">Ящик <b>' + esc(email) + '</b> создан.</div>' +
      '<div class="field" style="margin-top:10px"><label>Пароль (сохраните — повторно не показывается)</label>' +
      '<input type="text" class="mono" value="' + esc((r.data && r.data.password) || '') + '" readonly></div>',
      '<button class="btn primary" onclick="closeModal(); go(\'mail\')">Готово</button>');
  } catch(e){ toastErr(e); }
}
function mailBoxPwDlg(email){
  modal('Смена пароля: ' + esc(email),
    '<div class="field"><label>Новый пароль (мин. 6 символов)</label><div class="row">' +
    '<input type="text" id="mbp-pass">' +
    '<button class="btn" onclick="document.getElementById(\'mbp-pass\').value=genPass()">Сгенерировать</button></div></div>',
    '<button class="btn primary" onclick="mailBoxPw(\'' + esc(email) + '\')">Сменить</button>' +
    '<button class="btn" onclick="closeModal()">Отмена</button>');
  document.getElementById('mbp-pass').value = genPass();
}
async function mailBoxPw(email){
  try { const r = await api('/api/mail/boxes/password', {method:'POST',
      body:{email, password: document.getElementById('mbp-pass').value}});
    toast(esc(r.message)); closeModal(); }
  catch(e){ toastErr(e); }
}
function mailBoxDel(email){
  confirmDlg('Удалить ящик', 'Удалить ящик <b>' + esc(email) + '</b> вместе со всеми письмами?',
    async () => { try { const r = await api('/api/mail/boxes/remove', {method:'POST', body:{email}});
      toast(esc(r.message)); go('mail'); } catch(e){ toastErr(e); } });
}
async function mailBoxTest(email){
  toast('Отправляю тестовое письмо…');
  try { const r = await api('/api/mail/boxes/test', {method:'POST', body:{email}});
    toast(esc(r.message)); }
  catch(e){ toastErr(e); }
}

/* ---------- очистка журналов сайта ---------- */
function logsClear(kind){
  confirmDlg('Очистить журнал',
    'Все записи журнала «' + (kind === 'access' ? 'Access' : 'Error') + '» сайта ' +
    '<b>' + esc(window._site.domain) + '</b> будут удалены. Это безопасно — ' +
    'журнал начнёт заполняться заново.', async () => {
    try {
      const r = await api('/api/site/' + window._site.id + '/logs_clear',
        {method:'POST', body:{kind}});
      toast(esc(r.message)); siteLog(kind);
    } catch(e){ toastErr(e); }
  }, false);
}

/* ---------- подбор лимитов FPM ---------- */
async function stFpmReco(){
  try {
    const r = await api('/api/site/' + window._site.id + '/fpm_reco');
    const mc = document.getElementById('st-fpm-mc');
    const ss = document.getElementById('st-fpm-ss');
    if (mc) mc.value = r.max_children;
    if (ss) ss.value = r.start_servers;
    const el = document.getElementById('st-fpm-reco');
    if (el) el.textContent = 'Рекомендация: max_children ' + r.max_children;
    toast('Рекомендация: max_children = ' + r.max_children + ' (' + r.note + ')');
  } catch(e){ toastErr(e); }
}

/* ---------- полная диагностика DNS ---------- */
async function siteDnsFullDlg(){
  modal('Диагностика DNS: ' + esc(window._site.domain),
    '<div class="empty">Смотрю записи…</div>',
    '<button class="btn" onclick="closeModal()">Закрыть</button>', true);
  let r;
  try { r = await api('/api/site/' + window._site.id + '/dns_full'); }
  catch(e){ closeModal(); toastErr(e); return; }
  const pill = ok => ok ? '<span class="pill ok">ок</span>'
    : '<span class="pill warn">проверить</span>';
  const arr = a => (a && a.length ? a.join(', ') : '—');
  const kv = (name, okk, val) => '<div class="kv"><b>' + name + ' ' + pill(okk) +
    '</b><span class="mono" style="word-break:break-all">' + esc(val) + '</span></div>';
  modal('Диагностика DNS: ' + esc(r.domain),
    '<div class="notice info">Записи настраиваются у регистратора домена. ' +
    'A-записи должны указывать на IP сервера: <b class="mono">' +
    esc((r.server_ips || []).join(', ')) + '</b>. Изменения DNS применяются до нескольких часов.</div>' +
    kv('A (домен → IP)', r.a.ok, arr(r.a.current)) +
    kv('A (www)', r.www.ok, arr(r.www.current)) +
    kv('AAAA (IPv6)', true, arr(r.aaaa.current)) +
    kv('MX (почта)', true, arr(r.mx.current)) +
    kv('NS (серверы имён)', true, arr(r.ns.current)) +
    kv('SPF', r.spf.ok, arr(r.spf.current)) +
    (!r.spf.ok ? '<div class="notice warn" style="margin-top:8px">SPF-записи нет — письма с сайта могут попадать в спам. ' +
      'Рекомендуемая запись: <b class="mono">' + esc(r.spf.recommended) + '</b> (TXT, имя ' + esc(r.domain) + ')</div>' : '') +
    (r.demo ? '<div class="notice info">демо-данные</div>' : ''),
    '<button class="btn primary" onclick="closeModal()">Понятно</button>', true);
}

/* ---------- импорт сайта архивом ---------- */
function importArchiveDlg(){
  modal('Импорт сайта архивом',
    '<div class="notice info">Переезд с другого хостинга: загрузите zip с файлами сайта ' +
    'и при необходимости дамп базы (.sql / .sql.gz / .zip). Файлы распакуются в папку сайта, ' +
    'дамп импортируется в указанную базу. Если сайта ещё нет — создадим автоматически.</div>' +
    '<div class="field"><label>Домен сайта (существующий или новый)</label>' +
    '<input type="text" id="iarch-dom" class="mono" placeholder="mysite.ru"></div>' +
    '<label class="check"><input type="checkbox" id="iarch-clean" checked> ' +
    'Очистить папку сайта перед распаковкой (файлы будут заменены)</label>' +
    '<div class="field"><label>Zip с файлами сайта (до 200 МБ)</label>' +
    '<input type="file" id="iarch-zip" accept=".zip"></div>' +
    '<div class="field"><label>Дамп базы (необязательно)</label>' +
    '<input type="file" id="iarch-sql" accept=".sql,.gz,.zip"></div>' +
    '<div class="field"><label>База для дампа (имя; база должна существовать)</label>' +
    '<input type="text" id="iarch-db" class="mono" placeholder="mysite_db"></div>' +
    '<div id="iarch-out"></div>',
    '<button class="btn primary" onclick="importArchiveGo()">' + icon('up',15) + ' Импортировать</button>' +
    '<button class="btn" onclick="closeModal()">Отмена</button>', true);
}
async function importArchiveGo(){
  const dom = $('#iarch-dom').value.trim();
  const zip = $('#iarch-zip').files[0];
  if (!dom) { toast('Укажите домен', 'warn'); return; }
  if (!zip) { toast('Прикрепите zip-архив', 'warn'); return; }
  const out = document.getElementById('iarch-out');
  out.innerHTML = '<div class="notice info">Импортирую — не закрывайте окно…</div>';
  const fd = new FormData();
  fd.append('domain', dom);
  fd.append('clean', $('#iarch-clean').checked ? '1' : '0');
  fd.append('file', zip);
  const sql = $('#iarch-sql').files[0];
  if (sql) {
    fd.append('sql', sql);
    fd.append('db_name', $('#iarch-db').value.trim());
    fd.append('engine', 'mysql');
  }
  try {
    const r = await fetch('/api/sites/import', {method:'POST', body: fd})
      .then(x => x.json());
    if (!r.ok) throw new Error(r.error || 'ошибка импорта');
    out.innerHTML = '<div class="notice ok">' + esc(r.message) + '</div>';
    toast(esc(r.message));
    setTimeout(() => { closeModal(); go('sites'); }, 1800);
  } catch(e){
    out.innerHTML = '<div class="notice err">' + esc(e.message) + '</div>';
  }
}

/* ---------- DNS-записи почты: SPF/DKIM/DMARC ---------- */
async function mailDnsDlg(domain){
  modal('DNS-записи почты: ' + esc(domain),
    '<div class="empty">Загрузка…</div>',
    '<button class="btn" onclick="closeModal()">Закрыть</button>', true);
  let d;
  try { d = await api('/api/mail/dns?domain=' + encodeURIComponent(domain)); }
  catch(e){ closeModal(); toastErr(e); return; }
  const rec = r => '<div class="kv"><b>' + r.type + ' · <span class="mono">' + esc(r.name) + '</span></b>' +
    '<span class="mono" style="word-break:break-all">' + esc(r.value) + '</span></div>' +
    '<div class="row" style="align-items:center;gap:8px;margin-bottom:8px">' +
    (r.ok ? '<span class="pill ok">запись есть в DNS</span>'
          : '<span class="pill warn">записи нет — добавьте у регистратора</span>') +
    '<button class="btn sm" data-v="' + esc(r.value) + '" onclick="copyText(this.dataset.v, this)">' +
    icon('copy',13) + ' копировать</button></div>';
  modal('DNS-записи почты — ' + esc(domain),
    '<div class="notice info">Добавьте эти записи у регистратора домена. ' +
    'Без SPF/DKIM/DMARC письма с вашего сервера почти наверняка попадают в спам. ' +
    'IP сервера: <b class="mono">' + esc(d.server_ip || '—') + '</b>. ' +
    'Изменения DNS применяются до нескольких часов.</div>' +
    rec(d.records.spf) + rec(d.records.dmarc) + rec(d.records.dkim) +
    (!d.dkim_generated ? '<div class="row" style="margin-top:10px">' +
      '<button class="btn" onclick="mailDkimGen(\'' + esc(domain) + '\')">' +
      icon('zap',14) + ' Сгенерировать DKIM-ключ</button>' +
      '<span class="faint" style="font-size:11.5px">подпись писем DKIM требует также настройки opendkim в postfix — ключи сохранятся в панели</span></div>' : '') +
    (d.demo ? '<div class="notice info">демо-данные</div>' : ''),
    '<button class="btn primary" onclick="closeModal()">Готово</button>', true);
}
async function mailDkimGen(domain){
  try {
    const r = await api('/api/mail/dkim/generate', {method:'POST', body:{domain}});
    toast(esc(r.message)); mailDnsDlg(domain);
  } catch(e){ toastErr(e); }
}
