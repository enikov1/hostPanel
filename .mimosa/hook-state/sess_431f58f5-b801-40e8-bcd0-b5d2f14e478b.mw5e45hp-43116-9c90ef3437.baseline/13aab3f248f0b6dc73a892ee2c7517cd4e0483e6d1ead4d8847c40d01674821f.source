/* ============ boot.ts — вход/выход, приветственный мастер, колокольчик,
   глобальный поиск, запуск приложения ============ */
import { api, setUnauthorizedHook } from './api/client.js';
import { icon } from './core/icons.js';
import { esc, $ } from './core/format.js';
import { me, session, hooks } from './core/state.js';
import { NAV, buildNav, go, setBellUpdater } from './core/router.js';
import { applyTheme } from './core/theme.js';
import { toast, toastErr } from './components/toast.js';
import { modal, closeModal, unlockModal, isModalOpen } from './components/modal.js';
import { pwField, pwBindStrength } from './components/pw.js';
/* страницы: импорт с побочным эффектом — каждая регистрирует себя в роутере */
import './pages/monitoring.js';
import './pages/sites.js';
import './pages/dbs.js';
import './pages/mail.js';
import './pages/files.js';
import './pages/backups.js';
import './pages/cron.js';
import './pages/firewall.js';
import './pages/packages.js';
import './pages/software.js';
import './pages/swset.js';
