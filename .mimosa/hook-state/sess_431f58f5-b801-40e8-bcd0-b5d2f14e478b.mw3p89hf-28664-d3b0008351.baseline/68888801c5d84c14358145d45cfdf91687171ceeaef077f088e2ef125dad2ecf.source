  pause:'<rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/>',
  term:'<polyline points="4 17 10 11 4 5"/><line x1="12" y1="19" x2="20" y2="19"/>'
};
const icon = (n, s=17) => '<svg width="'+s+'" height="'+s+'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">'+(ICONS[n]||'')+'</svg>';
const $ = s => document.querySelector(s);
const esc = s => String(s==null?'':s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
const fmtSize = n => {
  if (n==null || isNaN(n)) return '—';
  n = Number(n);
  if (n < 1024) return Math.round(n) + ' Б';
  const u = ['КБ','МБ','ГБ','ТБ']; let i = -1;
  do { n /= 1024; i++; } while (n >= 1024 && i < u.length-1);
  return n.toFixed(1).replace('.', ',') + ' ' + u[i];
};
const fmtDate = s => s ? String(s).replace('T',' ').slice(0,16) : '—';
const humanUptime = s => {
  const d = Math.floor(s/86400), h = Math.floor(s%86400/3600), mm = Math.floor(s%3600/60);
  return (d? d + ' дн. ':'') + (h? h + ' ч. ':'') + mm + ' мин.';
};

async function api(path, opts = {}) {
  // аутентификация — HttpOnly-cookie (SameSite=Strict); CSRF на сервере
  // проверяется по Origin, токен в localStorage больше не хранится
  const init = {method: opts.method || 'GET', headers: {}};
  if (opts.body !== undefined) {
    init.method = opts.method || 'POST';
    init.headers['Content-Type'] = 'application/json';
    init.body = JSON.stringify(opts.body);
  }
  const r = await fetch(path, init);
  if (r.status === 401) { showLogin(); throw new Error('требуется вход'); }
  const j = await r.json();
  if (j && j.ok === false) throw new Error(j.error || 'ошибка запроса');
  return j;
}

function toast(msg, kind='ok') {
  const el = document.createElement('div');
  el.className = 'toast ' + kind;
  el.innerHTML = '<span style="flex:1">' + msg + '</span>';
  $('#toasts').appendChild(el);
  setTimeout(() => el.remove(), 5000);
}
/* ---------- объяснители ошибок: к типовым сбоям добавляем подсказку ------
   Задача — чтобы начинающий владелец сайта понимал, ЧТО делать дальше,
   а не только то, что «что-то не получилось». */
const ERROR_HINTS = [
  [/(?:dns problem|failed authorization|dns_ok|не указывает на сервер)/i,
   'Домен пока не указывает на этот сервер. Добавьте у регистратора A-запись: имя домена → IP сервера (показан на странице «Обзор»). Изменения DNS применяются до нескольких часов.'],
  [/certbot|сертификат/i,
   'Для Let\'s Encrypt нужны: домен, указывающий на сервер, и открытый порт 80. Самоподписанный сертификат можно выпустить без домена — браузер лишь покажет предупреждение.'],
  [/(?:nginx -t|ошибка синтаксиса|configtest)/i,
   'Панель уже откатила изменения — конфиг остался рабочим. Проверьте последние правки в редакторе конфига сайта или службы.'],
  [/(?:не установлена|не установлен|not installed)/i,
   'Установите недостающее в разделе «Система → Установка ПО» — там всё ставится в один клик.'],
  [/(?:mysqldump|pg_dump|дамп)/i,
   'Проверьте, что СУБД запущена (раздел «Службы»), и попробуйте ещё раз.'],
  [/(?:no space left|место на диске|переполнен)/i,
   'Диск заполнен. Освободите место: старые резервные копии, журналы, ненужные файлы сайтов.'],
  [/слишком много попыток/i,
   'Это защита от подбора пароля — подождите 5 минут и попробуйте снова.'],
  [/(?:connection refused|connection reset|недоступен|timed out|время ожидания)/i,
   'Похоже, служба не отвечает. Проверьте состояние служб в разделе «Службы» и их журналы.'],
  [/(?:пароль короче|пароль слишком короткий)/i,
   'Минимум 8 символов. Нажмите «сгенерировать» рядом с полем — панель создаст надёжный пароль за вас.'],
];
function explainError(m){
  let msg = String(m == null ? '' : m);
  for (const [rx, hint] of ERROR_HINTS)
    if (rx.test(msg)) return msg + ' — ' + hint;
  return msg;
}
const toastErr = e => toast(esc(explainError(e.message || String(e))), 'err');

/* ---------- копирование в буфер ---------- */
const copyIconSvg = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="9" y="9" width="13" height="13" rx="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>';
function copyText(text, btn) {
  const done = ok => {
    if (ok) { toast('Скопировано в буфер обмена'); if (btn) flashBtn(btn, 'Скопировано'); }
    else selectFallback(text);
  };
  if (navigator.clipboard && window.isSecureContext) {
    navigator.clipboard.writeText(text).then(() => done(true)).catch(() => done(false));
  } else done(false);
}
function selectFallback(text) {
  const ta = document.createElement('textarea');
  ta.value = text; ta.style.cssText = 'position:fixed;opacity:0';
  document.body.appendChild(ta); ta.select();
  try {
    document.execCommand('copy');
    toast('Скопировано в буфер обмена');
  } catch(e) { toast('Не удалось скопировать — выделите текст вручную', 'warn'); }
  ta.remove();
}
function flashBtn(btn, label) {
  if (!btn) return;
  const old = btn.innerHTML;
  btn.innerHTML = icon('check', 14) + ' ' + (label || 'Скопировано');
  btn.classList.add('ok');
  setTimeout(() => { btn.innerHTML = old; btn.classList.remove('ok'); }, 1600);
}

/* ---------- генератор и поле пароля ---------- */
function genPassword(len=16) {
  const a = 'abcdefghjkmnpqrstuvwxyz', A = 'ABCDEFGHJKMNPQRSTUVWXYZ',
        d = '23456789', s = '!@#$%&*_-+=';
  const all = a + A + d + s;
  const pick = set => set[Math.floor(Math.random() * set.length)];
  let p = pick(a) + pick(A) + pick(d) + pick(s);
  for (let i = p.length; i < len; i++) p += pick(all);
  return p.split('').sort(() => Math.random() - 0.5).join('');
}
function pwStrength(pw) {
  if (!pw) return 0;
  let score = 0;
  if (pw.length >= 8) score++;
  if (pw.length >= 12) score++;
  if (/[a-z]/.test(pw) && /[A-Z]/.test(pw)) score++;
  if (/\d/.test(pw)) score++;
  if (/[^a-zA-Z0-9]/.test(pw)) score++;
  return Math.min(3, Math.floor(score / 2) + (score >= 4 ? 1 : 0));
}
/* pwField(id, opts): input + генерация + показ + копирование + индикатор */
function pwField(id, opts={}) {
  const ph = opts.placeholder || 'минимум 8 символов';
  const gen = opts.gen !== false;
  return '<div class="field"><label>' + (opts.label || 'Пароль') + '</label>' +
    '<div class="pw-row">' +
    '<input type="text" id="' + id + '" class="mono" placeholder="' + ph + '" autocomplete="new-password">' +
    (gen ? '<button class="btn" type="button" title="Сгенерировать надёжный пароль" onclick="pwGenerate(\'' + id + '\')">' + icon('refresh',14) + '</button>' : '') +
    '<button class="btn" type="button" title="Показать/скрыть" onclick="pwToggle(\'' + id + '\', this)">' + icon('lock',14) + '</button>' +
    '<button class="btn" type="button" title="Скопировать" onclick="copyText(document.getElementById(\'' + id + '\').value, this)">' + copyIconSvg + '</button>' +
    '</div><div class="pw-strength" id="' + id + '-str"><i></i><i></i><i></i></div>' +
    '<div class="faint" style="font-size:11.5px;margin-top:4px" id="' + id + '-hint">' +
    (opts.hint || 'Придумайте пароль или нажмите кнопку генерации — надёжный пароль создастся сам.') +
    '</div></div>';
}
function pwGenerate(id) {
  const inp = document.getElementById(id);
  inp.value = genPassword();
  inp.dispatchEvent(new Event('input'));
  toast('Надёжный пароль сгенерирован — не забудьте скопировать его');
}
function pwToggle(id, btn) {
  const inp = document.getElementById(id);
  inp.type = inp.type === 'password' ? 'text' : 'password';
}
function pwBindStrength(id) {
  const inp = document.getElementById(id);
  if (!inp) return;
  inp.addEventListener('input', () => {
    const s = pwStrength(inp.value);
    const bar = document.getElementById(id + '-str');
    if (bar) Array.from(bar.children).forEach((el, i) => {
      el.className = i < s ? 'f' + s : '';
    });
  });
}
/* credRow(key, value, mono): строка параметра с кнопкой копирования */
function credRow(key, value, id) {
  const vid = id || ('cr-' + Math.random().toString(36).slice(2, 8));
  return '<div class="cred-row"><span class="k">' + esc(key) + '</span>' +
    '<span class="v" id="' + vid + '">' + esc(value) + '</span>' +
    '<button class="btn sm icon" type="button" title="Скопировать" onclick="copyText(document.getElementById(\'' + vid + '\').value || document.getElementById(\'' + vid + '\').textContent, this)">' + copyIconSvg + '</button></div>';
}

let MODAL_LOCKED = false;
function modal(title, bodyHtml, footHtml, wide=false, locked=false) {
  MODAL_LOCKED = locked;
  $('#modals').classList.add('open');
  const m = $('#modal');
  m.className = 'modal' + (wide === 2 ? ' xwide' : wide ? ' wide' : '');
  m.innerHTML =
    '<div class="modal-h">' + title +
    (locked ? '' :
      '<button class="btn icon modal-x" onclick="closeModal()">' + icon('x',15) + '</button>') +
    '</div>' +
    '<div class="modal-b">' + bodyHtml + '</div>' +
    (footHtml ? '<div class="modal-f">' + footHtml + '</div>' : '');
}
function closeModal(){
  if (MODAL_LOCKED) return;
  $('#modals').classList.remove('open'); $('#modal').innerHTML='';
  MODAL_LOCKED = false;
}
document.addEventListener('mousedown', e => {
  if (e.target.id === 'modals' && !MODAL_LOCKED) closeModal();
});
document.addEventListener('keydown', e => {
  if (e.key === 'Escape' && !MODAL_LOCKED) closeModal();
});
function confirmDlg(title, text, onOk, danger=true) {
  window._confirmOk = onOk;
  modal(esc(title), '<p style="margin:4px 0 6px">' + text + '</p>',
    '<button class="btn' + (danger?' danger':' primary') +
    '" onclick="closeModal(); (window._confirmOk||function(){})()">Подтвердить</button>' +
    '<button class="btn" onclick="closeModal()">Отмена</button>');
}

/* ---------- график-канвас ---------- */
function cssVar(n){ return getComputedStyle(document.documentElement).getPropertyValue(n).trim(); }
function drawLine(cv, series, opts={}) {
  if (!cv) return;
  const dpr = window.devicePixelRatio || 1;
  const w = cv.clientWidth || 300, h = cv.clientHeight || 200;
  cv.width = w * dpr; cv.height = h * dpr;
  const ctx = cv.getContext('2d'); ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,w,h);
  const padL = 38, padR = 8, padT = 8, padB = 20;
  let max = opts.max || Math.max(...series.reduce((a,s)=>a.concat(s.data),[]), 1) * 1.15;
  const n = series[0].data.length;
  const X = i => padL + (w-padL-padR) * (n<2?0:i/(n-1));
  const Y = v => padT + (h-padT-padB) * (1 - Math.min(v/max, 1));
  ctx.strokeStyle = cssVar('--border'); ctx.fillStyle = cssVar('--muted');
  ctx.font = '10.5px sans-serif'; ctx.lineWidth = 1;
  for (let g=0; g<=4; g++) {
    const y = padT + (h-padT-padB)*g/4;
    ctx.beginPath(); ctx.moveTo(padL,y); ctx.lineTo(w-padR,y); ctx.stroke();
    ctx.textAlign='right'; ctx.fillText(String(Math.round(max*(1-g/4))), padL-5, y+3);
  }
  series.forEach(s => {
    if (s.fill) {
      const grad = ctx.createLinearGradient(0,padT,0,h-padB);
      grad.addColorStop(0, s.color + '44'); grad.addColorStop(1, s.color + '00');
      ctx.beginPath(); ctx.moveTo(X(0), Y(s.data[0]));
      for (let i=1;i<n;i++) ctx.lineTo(X(i), Y(s.data[i]));
      ctx.lineTo(X(n-1), h-padB); ctx.lineTo(X(0), h-padB); ctx.closePath();
      ctx.fillStyle = grad; ctx.fill();
    }
    ctx.beginPath(); ctx.moveTo(X(0), Y(s.data[0]));
    for (let i=1;i<n;i++) ctx.lineTo(X(i), Y(s.data[i]));
    ctx.strokeStyle = s.color; ctx.lineWidth = 1.8; ctx.stroke();
  });
  if (opts.labels && opts.labels.length) {
    ctx.textAlign='left'; ctx.fillStyle = cssVar('--faint');
    ctx.fillText(opts.labels[0], padL, h-6);
    ctx.textAlign='right'; ctx.fillText(opts.labels[opts.labels.length-1], w-padR, h-6);
  }
}
/* столбчатый график доступности (живучесть): ok=зелёный, fail=красный */
function drawUptime(cv, series) {
  if (!cv) return;
  const dpr = window.devicePixelRatio || 1;
  const w = cv.clientWidth || 300, h = cv.clientHeight || 60;
  cv.width = w * dpr; cv.height = h * dpr;
  const ctx = cv.getContext('2d'); ctx.setTransform(dpr,0,0,dpr,0,0);
  ctx.clearRect(0,0,w,h);
  const n = series.length; if (!n) return;
  const bw = Math.max(2, Math.min(10, (w-4)/n - 2));
  series.forEach((v,i) => {
    ctx.fillStyle = v.ok ? cssVar('--ok') : cssVar('--err');
    const bh = v.ok ? Math.max(4, (h-6) * Math.min(1, v.ms/300)) : (h-6);
    ctx.fillRect(2 + i*((w-4)/n), h-3-bh, bw, bh);
  });
}
function statCard(ic, cls, val, label, barPct, barCls){
  return '<div class="card" style="margin:0"><div class="stat"><span class="stat-ico '+cls+'">'+
    icon(ic,20)+'</span><div style="flex:1"><div class="stat-v">'+val+'</div>'+
    '<div class="stat-l">'+label+'</div>' +
    (barPct != null ? '<div class="bar"><i class="'+(barCls||'')+'" style="width:'+barPct+'%"></i></div>' : '') +
    '</div></div></div>';
}
function showLogin(){
  $('#app').classList.add('hidden');
  $('#login').classList.remove('hidden');
}

/* ============ Редактор кода с подсветкой (Prism, оверлей) ============ */
/* Определяем язык Prism по пути файла или по типу конфига панели */
function prismLangFromPath(path){
  const ext = (path.split('.').pop() || '').toLowerCase();
  const map = {php:'php', conf:'nginx', ini:'ini', sql:'sql', json:'json',
    js:'javascript', mjs:'javascript', css:'css', html:'markup', htm:'markup',
    py:'python', sh:'bash', yml:'yaml', yaml:'yaml', htaccess:'apacheconf',
    htpasswd:'apacheconf', md:'markup', xml:'markup', cnf:'ini', env:'bash',
    service:'ini', timer:'ini', socket:'ini'};
  if (path.includes('nginx')) return 'nginx';
  if (path.includes('apache') || path.includes('.ht')) return 'apacheconf';
  return map[ext] || 'markup';
}
function prismLangFromKind(kind){
  return {nginx:'nginx', apache:'apacheconf', fpm:'ini', php:'ini',
    ini:'ini', conf:'bash', postfix:'ini', dovecot:'bash',
    fail2ban:'ini'}[kind] || 'markup';
}
/* Монтирует в el редактор: гуттер с номерами строк, слой подсветки,
   прозрачный textarea поверх. Возвращает {get, el}. */
function mountCodeEditor(el, value, lang){
  el.classList.add('code-wrap');
  el.innerHTML =
    '<div class="code-gutter mono"></div>' +
    '<div class="code-scroll"><pre class="code-hl language-' + lang +
    '"><code class="language-' + lang + '"></code></pre>' +
    '<textarea class="code-input mono" spellcheck="false" autocomplete="off"></textarea></div>';
  const ta = el.querySelector('.code-input');
  const hl = el.querySelector('.code-hl');
  const code = el.querySelector('.code-hl code');
  const gut = el.querySelector('.code-gutter');
  ta.value = value || '';
  function render(){
    const text = ta.value;
    let html;
    try { html = Prism.highlight(text, Prism.languages[lang] ||
                                Prism.languages.markup, lang); }
    catch(e) { html = esc(text); }
    code.innerHTML = html + '\n';
    const lines = text.split('\n').length;
    let g = '';
    for (let i = 1; i <= lines; i++) g += i + '\n';
    gut.textContent = g;
  }
  ta.addEventListener('input', render);
  ta.addEventListener('scroll', () => {
    hl.parentElement.scrollTop = ta.scrollTop;
    hl.parentElement.scrollLeft = ta.scrollLeft;
    gut.scrollTop = ta.scrollTop;
  });
  ta.addEventListener('keydown', e => {
    if (e.key === 'Tab') {
      e.preventDefault();
      const s = ta.selectionStart, en = ta.selectionEnd;
      ta.value = ta.value.slice(0, s) + '    ' + ta.value.slice(en);
      ta.selectionStart = ta.selectionEnd = s + 4;
      render();
    }
  });
  render();
  return {get: () => ta.value, el};
}
