    "apps": cmd_apps, "help": cmd_help,
}

# команды, работающие без CLI-токена и root
OPEN_COMMANDS = {"login", "help"}


def main():
    global _TOKEN
    argv = sys.argv[1:]
    if not argv:
        cmd_help([])
        return
    cmd = argv[0]
    if cmd in ("-h", "--help"):
        cmd = "help"
    fn = COMMANDS.get(cmd)
    if not fn:
        fail("неизвестная команда: %s (список: hcp-help)" % cmd, 2)
    if cmd == "reset-password":
        # аварийная команда: работает и БЕЗ CLI-токена (одноразовый код
        # root), поэтому отсутствие/просроченность токена не фатально —
        # cmd_reset_password сам переключится на аварийный путь
        need_root()
        if os.path.exists(TOKEN_FILE):
            try:
                with open(TOKEN_FILE, encoding="utf-8") as f:
                    _TOKEN = f.read().strip()
            except OSError:
                _TOKEN = ""
    elif cmd not in OPEN_COMMANDS:
        need_root()
        if os.path.exists(TOKEN_FILE):
            _TOKEN = read_token()
            resp = api("GET", "/api/me")
            if not resp.get("ok") and cmd != "logout":
                fail(resp.get("error", "токен отклонён") +
                     " — выполните hcp-login заново")
        elif cmd != "logout":
            fail("CLI-токен не найден (%s) — сначала выполните hcp-login"
                 % TOKEN_FILE)
    fn(argv[1:])


if __name__ == "__main__":
    main()
